var AddressTypeOptionCache = {
	initialized: false,
	optionsByValue: {}
};

function OnLoad(executionContext)
{
	"use strict";
	try
	{
		// updateFormName(executionContext);
		var formContext = executionContext.getFormContext(); 
		filterAddressTypeForInvestor(executionContext);
		lockUnlockAddressType(executionContext);
		if (formContext.getAttribute('kofc_addresschangestatuscode') !== null)
		{
			if (formContext.getAttribute("addresstypecode") !== null) formContext.getAttribute("addresstypecode").addOnChange(SetReasonCode);
			if (formContext.getAttribute("line1") !== null) formContext.getAttribute("line1").addOnChange(SetReasonCode);
			if (formContext.getAttribute("line2") !== null) formContext.getAttribute("line2").addOnChange(SetReasonCode);
			if (formContext.getAttribute("line3") !== null) formContext.getAttribute("line3").addOnChange(SetReasonCode);
			if (formContext.getAttribute("city") !== null) formContext.getAttribute("city").addOnChange(SetReasonCode);
			if (formContext.getAttribute("kofc_address2_country") !== null) formContext.getAttribute("kofc_address2_country").addOnChange(SetReasonCode);
			if (formContext.getAttribute("postalcode") !== null) formContext.getAttribute("postalcode").addOnChange(SetReasonCode);
			if (formContext.getAttribute("kofc_address2_stateorprovince") !== null) formContext.getAttribute("kofc_address2_stateorprovince").addOnChange(SetReasonCode);
			if (formContext.getAttribute('kofc_addresschangestatuscode').getValue() !== null) formContext.getAttribute('kofc_addresschangestatuscode').setRequiredLevel("required");
			if (formContext.ui.getFormType() === 1) formContext.getAttribute('kofc_addresschangestatuscode').setRequiredLevel("none");
			sessionStorage.removeItem("errorNotificationShown");
		}
		if (formContext.getAttribute("parentid"))
		{
			formContext.getAttribute("parentid").addOnChange(function ()
			{
				filterAddressTypeForInvestor(executionContext);
			});
		}
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in OnLoad: ' + (error.description || error.message));
	}
}

function onSave(executionContext)
{
	"use strict";
	return checkDuplicateAddressType(executionContext);
};
