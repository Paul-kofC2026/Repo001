function lockUnlockAddressType(executionContext)
{
	"use strict";
	try
	{
		var formContext = executionContext.getFormContext();
		var addressTypeCtrl = formContext.getControl("addresstypecode");
		var addressTypeAttr = formContext.getAttribute("addresstypecode");
		var formType = formContext.ui.getFormType();
		if (!addressTypeCtrl || !formType || !addressTypeAttr) return;
		//check if its not a create form and also Address Type has a value
		const isValidAddress = formType !== 1 && addressTypeAttr.getValue() !== "null";
		isValidAddress ? addressTypeCtrl.setDisabled(true) : addressTypeCtrl.setDisabled(false);
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error while locking Address Type Field: ' + (error.description || error.message));
	}
}
