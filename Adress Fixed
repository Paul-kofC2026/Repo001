function filterAddressTypeForInvestor(executionContext)
{
	"use strict";
	try
	{
		var formContext = executionContext.getFormContext();
		var attr = formContext.getAttribute("addresstypecode");
		var ctrl = formContext.getControl("addresstypecode");
		if (!attr || !ctrl) return;
		ensureAddressTypeOptionCache(ctrl);
		// get parent Contact lookup
		var parent = formContext.getAttribute("parentid") ? formContext.getAttribute("parentid").getValue() : null;
		if (!parent || !parent.length)
		{
			hideInvestorOnlyOptions(ctrl);
			return;
		}
		var contactId = (parent[0].id || "").replace(/[{}]/g, "");
		// retrieve kofc_contacttype from parent contact
		Xrm.WebApi.retrieveRecord("contact", contactId, "?$select=kofc_contacttype").then(function (rec)
		{
			var formatted = rec["kofc_contacttype"] || "";
			var isInvestor = false;
			var isClient = false;
			var isDonor = false;
			if (formatted)
			{
				// Multi-select formatted looks like "INVESTOR; OTHER"
				var labels = formatted.split(";").map(s => s.trim().toUpperCase()).flatMap(s => s.split(","));
				isInvestor = labels.indexOf("258510005") !== -1;
				isClient = labels.indexOf("258510003") !== -1;
				isDonor = labels.indexOf("258510002") !== -1;
			}
			if (isDonor)
			{
				safeAddOption(ctrl, 18);
			}
			else
			{
				safeRemoveOption(ctrl, 18);
				var v = attr.getValue();
				if (v === 18)
				{
					attr.setValue(null);
				}
			}
			if (isInvestor)
			{
				showInvestorOnlyOptions(ctrl);
			}
			else
			{
				hideInvestorOnlyOptions(ctrl);
				var v = attr.getValue();
				if (v === 16 || v === 15)
				{
					attr.setValue(null);
				}
			}
			if (isClient && CheckKCCFrole())
			{ //show when contactType is Client and also has KCCF role
				safeAddOptionctrl(ctrl, 17);
			}
			else
			{
				safeRemoveOption(ctrl, 17);
			}
		}).
		catch (function ()
		{
			// default: hide if error occurs
			hideInvestorOnlyOptions(ctrl);
		});
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in filterAddressTypeForInvestor: ' + (error.description || error.message));
	}
}

function ensureAddressTypeOptionCache(ctrl)
{
	"use strict";
	if (AddressTypeOptionCache.initialized) return;
	(ctrl.getOptions() || []).forEach(function (op, i)
	{
		if (op && (op.value === 16 || op.value === 15))
		{
			AddressTypeOptionCache.optionsByValue[String(op.value)] = {
				value: op.value,
				text: op.text,
				index: i
			};
		}
	});
	AddressTypeOptionCache.initialized = true;
}

function hideInvestorOnlyOptions(ctrl)
{
	"use strict";
	safeRemoveOption(ctrl, 15);
	safeRemoveOption(ctrl, 16);
}

function showInvestorOnlyOptions(ctrl)
{
	"use strict";
	safeAddOption(ctrl, 15);
	safeAddOption(ctrl, 16);
}

function safeRemoveOption(ctrl, value)
{
	"use strict";
	try
	{
		var exists = (ctrl.getOptions() || []).some(function (o)
		{
			return o.value === value;
		});
		if (exists) ctrl.removeOption(value);
	}
	catch (_)
	{}
}

function safeAddOption(ctrl, value)
{
	"use strict";
	try
	{
		var exists = (ctrl.getOptions() || []).some(function (o)
		{
			return o.value === value;
		});
		if (exists) return;
		var meta = AddressTypeOptionCache.optionsByValue[String(value)];
		ctrl.addOption(
		{
			text: meta ? meta.text : ("Value " + value),
			value: value
		});
	}
	catch (_)
	{}
}
