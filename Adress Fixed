//Function to set Reason Code mandatory based on Role of User

function SetReasonCode(executionContext)
{
	"use strict";
	try
	{
		var formContext = executionContext.getFormContext();
		var addressTypeAttr = formContext.getAttribute("addresstypecode");
		var statusAttr = formContext.getAttribute("kofc_addresschangestatuscode");
		if (!statusAttr) return;
		// Always optional in Create mode
		if (formContext.ui.getFormType() === 1)
		{
			statusAttr.setRequiredLevel("none");
			return;
		}
		// Get selected address type
		var addressTypeVal = addressTypeAttr ? addressTypeAttr.getValue() : null;
		// NEW >>> If address type = 16 or 15, make it optional
		if (addressTypeVal === 16 || addressTypeVal === 15 || (addressTypeVal === 17 && CheckKCCFrole()))
		{
			statusAttr.setRequiredLevel("none");
			return;
		}
		// NEW <<<
		// Otherwise, required by default
		statusAttr.setRequiredLevel("required");
		// Check for Field Agent role
		var isFieldAgent = CheckFieldAgent();
		if (isFieldAgent)
		{
			statusAttr.setValue(2); // auto-set Reason Code
		}
		else
		{
			statusAttr.setValue(null);
		}
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in SetReasonCode: ' + (error.description || error.message));
	}
}
//US:21765

function CheckFieldAgent()
{
	"use strict";
	var hasRoleFA = false;
	try
	{
		var roles = Xrm.Utility.getGlobalContext().userSettings.roles;
		if (roles !== null && roles !== undefined)
		{
			roles.forEach(function (item)
			{
				if (item.name.toLowerCase() === "insurance sales")
				{
					hasRoleFA = true;
				}
			});
		}
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in CheckFieldAgent: ' + (error.description || error.message));
	}
	return hasRoleFA;
}

function CheckKCCFrole()
{
	"use strict";
	var hasRoleFA = false;
	try
	{
		var roles = Xrm.Utility.getGlobalContext().userSettings.roles;
		if (roles !== null && roles !== undefined)
		{
			roles.forEach(function (item)
			{
				if (item.name.toLowerCase() === "kccf leader" || item.name.toLowerCase() === "kccf user" || item.name.toLowerCase() === "kccf vip user" || item.name.toLowerCase() === "system administrator" || item.name.toLowerCase() === "system customizer")
				{
					hasRoleFA = true;
				}
			});
		}
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in CheckFieldAgent: ' + (error.description || error.message));
	}
	return hasRoleFA;
}

