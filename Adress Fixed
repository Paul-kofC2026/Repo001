function checkDuplicateAddressType(executionContext)
{
	"use strict";
	try
	{
		var formContext = executionContext.getFormContext();
		var addressRecordId = formContext.data.entity.getId();
		var parentContactId = formContext.getAttribute("parentid").getValue();
		var addressType = formContext.getAttribute("addresstypecode").getValue();
		var addressTypeText = formContext.getAttribute("addresstypecode").getText();
		//check if the notification has already been show
		//To avoid multiple notofications on auto save
		if (sessionStorage.getItem("errorNotificationShown") === "true")
		{
			executionContext.getEventArgs().preventDefault();
			return;
		}
		if (!parentContactId || !addressType)
		{
			return;
		}
		var contactGuid = parentContactId[0].id.replace("{", "").replace("}", "");
		var _fetchXml = "<fetch version='1.0' output-format='xml-platform' mapping='logical' distinct='false'>" +
			"<entity name='customeraddress'>" +
			"<attribute name='addresstypecode' />" +
			"<attribute name='customeraddressid' />" + //Fetch Address record ID
		"<filter type='and'>" +
			"<condition attribute='addresstypecode' operator='eq' value='" + addressType + "' />" +
			"</filter>" +
			"<link-entity name='contact' from='contactid' to='parentid' link-type='inner' alias='ab'>" +
			"<filter type='and'>" +
			"<condition attribute='contactid' operator='eq' uiname='' uitype='contact' value='" + contactGuid + "' />" +
			"</filter>" +
			"</link-entity>" +
			"</entity>" +
			"</fetch>";
		return new Promise(function (resolve)
		{
		var req = new XMLHttpRequest();
		var globalContext = Xrm.Utility.getGlobalContext();
		req.open("GET", globalContext.getClientUrl() + "/api/data/v9.2/customeraddresses?fetchXml=" + encodeURIComponent(_fetchXml), true);
		req.setRequestHeader("OData-MaxVersion", "4.0");
		req.setRequestHeader("OData-Version", "4.0");
		req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
		req.setRequestHeader("Accept", "application/json");
		req.setRequestHeader("Prefer", "odata.include-annotations=*");
		req.onreadystatechange = function ()
		{
			if (this.readyState === 4)
			{
				req.onreadystatechange = null;
				if (this.status === 200)
				{
					var result = JSON.parse(this.response);
					if (result !== null && result.value.length > 0)
					{
						var isDuplicate = result.value.some(function (addressRecord)
						{
							var currentRecordId = addressRecord["customeraddressid"];
							//if the duplicate is the same reocrd being edited, then allow save.
							if (addressRecordId && currentRecordId.toLowerCase() === addressRecordId.replace("{", "").replace("}", "").toLowerCase())
							{
								return false;
							}
							showDuplicateAddressAlert(addressTypeText, executionContext);
							return true;
						});
					}
				}
				resolve();
			}
		};
		req.onerror = function ()
		{
			Xrm.Navigation.openAlertDialog(
			{
				text: "An error occurred while saving Address record."
			});
			resolve();
		};
		req.send();
		});
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in checkDuplicateAddressType: ' + (error.description || error.message));
	}
};

function showDuplicateAddressAlert(addressTypeText, executionContext)
{
	"use strict";
	try
	{
		var formContext = executionContext.getFormContext();
		var alertStrings = {
			confirmButtonLabel: "OK",
			text: "Error Message: There is another " + addressTypeText + " present. Only one Address record can be of " + addressTypeText + " Type.",
			title: "Business Process Error"
		};
		var alertOptions = {
			height: 220,
			width: 400
		};
		Xrm.Navigation.openAlertDialog(alertStrings, alertOptions).then(

		function (success)
		{
			sessionStorage.setItem("errorNotificationShown", "true");
			formContext.getControl("addresstypecode").setFocus();
			return;
		});
		executionContext.getEventArgs().preventDefault();
	}
	catch (error)
	{
		Xrm.Navigation.openAlertDialog('Error in checkDuplicateAddressType: ' + (error.description || error.message));
	}
};
