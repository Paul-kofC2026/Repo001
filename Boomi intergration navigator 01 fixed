    <h2>Validation log</h2>
    <pre id="log"></pre>

    <script>
        (function () {
            "use strict";

            var VALIDATOR_NAME = "Boomi Integration Validator";
            var logEl = document.getElementById("log");
            var msalApp = null;
            var msalLoadPromise = null;
            var authInProgress = false;

            function log(message, isError) {
                var line = "[" + new Date().toLocaleTimeString() + "] " + message;
                logEl.textContent += line + "\n";
                logEl.className = isError ? "err" : "";
                console.log(message);
            }

            function clean(value) {
                // Strip surrounding whitespace and any stray quotes from pasted values.
                return (value || "").trim().replace(/^["']+|["']+$/g, "");
            }

            var tokenDisplayEl = document.getElementById("tokenDisplay");

            function showToken(token) {
                tokenDisplayEl.textContent = token || "(no token yet)";
            }

            function getRequestPayload() {
                try {
                    var raw = document.getElementById("requestPayload").value.trim();
                    return raw ? JSON.parse(raw) : {};
                } catch (e) {
                    throw new Error("Request params is not valid JSON: " + e.message);
                }
            }

            function getConfig() {
                var payload = getRequestPayload();
                return {
                    tenantId: clean(document.getElementById("tenantId").value),
                    clientId: clean(document.getElementById("clientId").value),
                    apiAppId: clean(document.getElementById("apiAppId").value),
                    scopes: clean(document.getElementById("scopes").value),
                    loginHint: clean(document.getElementById("loginHint").value),
                    redirectUri: clean(document.getElementById("redirectUri").value),
                    boomiUrl: document.getElementById("boomiUrl").value.trim(),
                    httpMethod: (document.getElementById("httpMethod").value || "POST").toUpperCase(),
                    userId: payload.userId || "",
                    oppId: payload.oppID || payload.oppId || "",
                    requestPayload: payload
                };
            }

            function validateConfig(cfg, requireBoomi) {
                if (!cfg.tenantId || !cfg.clientId || !cfg.apiAppId) {
                    throw new Error("Tenant ID, SPA Client ID, and Function API App ID are required.");
                }
                if (requireBoomi && !cfg.boomiUrl) {
                    throw new Error("Boomi URL is required.");
                }
            /*  if (requireBoomi ) {
                    throw new Error("Boomi API key (x-api-key) is required.");
                }*/
            }

            function getScopes(cfg) {
                var raw = (cfg.scopes || "access_as_user").split(/\s+/);
                return raw
                    .filter(function (s) { return s; })
                    .map(function (s) {
                        // Allow either bare scope names or full api://.../scope values.
                        return s.indexOf("api://") === 0 ? s : "api://" + cfg.apiAppId + "/" + s;
                    });
            }

            function tryLoadScript(src) {
                return new Promise(function (resolve, reject) {
                    var script = document.createElement("script");
                    script.src = src;
                    script.onload = function () {
                        resolve(typeof msal !== "undefined");
                    };
                    script.onerror = function () {
                        reject(new Error("404/blocked: " + src));
                    };
                    document.head.appendChild(script);
                });
            }

            async function loadMsalLibrary() {
                if (typeof msal !== "undefined") {
                    return;
                }

                if (msalLoadPromise) {
                    return msalLoadPromise;
                }

                // The uploaded MSAL web resource name varies; try common variants.
                var base = window.location.origin + "/WebResources/";
                var candidates = [
                    "kofc_msal-browser.min.js",
                    "kofc_msalbrowsermin",
                    "kofc_msal_browser_min",
                    "kofc_msalbrowser.min.js",
                    "kofc_msal-browser"
                ];

                msalLoadPromise = (async function () {
                    for (var i = 0; i < candidates.length; i++) {
                        try {
                            log("Loading MSAL from: " + base + candidates[i], false);
                            await tryLoadScript(base + candidates[i]);
                            if (typeof msal !== "undefined") {
                                log("MSAL loaded: " + candidates[i], false);
                                return;
                            }
                        } catch (e) {
                            // Try next candidate.
                        }
                    }
                    throw new Error(
                        "MSAL blocked or missing. Upload the MSAL bundle as a Script web resource and make its " +
                        "name match one of: " + candidates.join(", ") + " (or tell me the exact name you used)."
                    );
                })();

                return msalLoadPromise;
            }

            var CFG_KEY = "biv_cfg";       // shared with callback (localStorage)
            var RESULT_KEY = "biv_result"; // token result written by callback

            function getDefaultRedirectUri() {
                // Point at the minimal, SERVED callback page (kofc_msalcallback.html), not the
                // validator itself. This is the single SPA redirect URI to register in Entra
                // and lets ssoSilent (hidden iframe) complete without any popup/redirect.
                return window.location.origin + "/WebResources/kofc_msalcallback.html";
            }

            function getRedirectUri() {
                // MUST be a served URL (no 404), with NO query string, and registered in
                // Entra as a SPA redirect URI. If /WebResources/<name>.html 404s, set this
                // field to the exact URL that actually loads the validator top-level.
                var el = document.getElementById("redirectUri");
                var val = el ? clean(el.value) : "";
                return val || getDefaultRedirectUri();
            }

            // A page is framed (at any depth) exactly when its parent is not itself.
            // Never throws, even when the parent is cross-origin.
            // (Solution checker: web-avoid-window-top.)
            function isFramed() {
                return window.parent !== window;
            }

            // Direct parent only, and only when it is a different, same-origin frame.
            // Never walks past the direct parent.
            function getSameOriginParent() {
                try {
                    if (window.parent && window.parent !== window) {
                        // Touching location throws if the parent is cross-origin.
                        void window.parent.location.href;
                        return window.parent;
                    }
                } catch (e) { /* cross-origin parent */ }
                return null;
            }

            function isMainAspx(loc) {
                try {
                    return /\/main\.aspx$/i.test(loc.pathname);
                } catch (e) {
                    return false;
                }
            }

            function getReturnUrl() {
                // The D365 shell URL that loaded this validator. We return here after
                // sign-in so we stay in the app context instead of a bare main.aspx
                // that D365 bounces to the admin/home page.
                if (isMainAspx(window.location)) {
                    return window.location.href;
                }
                var p = getSameOriginParent();
                if (p) {
                    try {
                        if (isMainAspx(p.location)) {
                            return p.location.href;
                        }
                    } catch (e) { /* ignore */ }
                }
                return window.location.href;
            }

            function saveState(cfg, action) {
                try {
                    var payload = {};
                    Object.keys(cfg).forEach(function (k) { payload[k] = cfg[k]; });
                    payload.action = action;
                    payload.returnUrl = getReturnUrl();
                    localStorage.setItem(CFG_KEY, JSON.stringify(payload));
                } catch (e) {
                    // ignore
                }
            }

            function readCfgState() {
                try {
                    var raw = localStorage.getItem(CFG_KEY);
                    return raw ? JSON.parse(raw) : null;
                } catch (e) {
                    return null;
                }
            }

            function readResult() {
                try {
                    var raw = localStorage.getItem(RESULT_KEY);
                    return raw ? JSON.parse(raw) : null;
                } catch (e) {
                    return null;
                }
            }

            function clearResult() {
                try {
                    localStorage.removeItem(RESULT_KEY);
                } catch (e) {
                    // ignore
                }
            }

            function applyConfigToForm(cfg) {
                if (!cfg) {
                    return;
                }
                var map = {
                    tenantId: cfg.tenantId, clientId: cfg.clientId, apiAppId: cfg.apiAppId,
                    scopes: cfg.scopes, loginHint: cfg.loginHint, redirectUri: cfg.redirectUri,
                    boomiUrl: cfg.boomiUrl, boomiApiKey: cfg.boomiApiKey,
                    httpMethod: cfg.httpMethod
                };
                Object.keys(map).forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el && typeof map[id] === "string" && map[id]) {
                        el.value = map[id];
                    }
                });
                if (cfg.requestPayload) {
                    setPayload(cfg.requestPayload);
                } else if (cfg.userId) {
                    var payload = { userId: cfg.userId };
                    if (cfg.oppId) { payload.oppID = cfg.oppId; }
                    setPayload(payload);
                }
            }

            function buildNavigationClient() {
                // Microsoft's login page cannot be framed, so when this validator runs inside
                // the D365 shell the sign-in must replace the whole page. The "_top" target
                // navigates the top-level browsing context (like <a target="_top">) without
                // reading or writing any property of the top window object, so it cannot
                // raise a cross-origin error. The browser still enforces its navigation rules.
                var client = new msal.NavigationClient();
                client.navigateExternal = function (url, options) {
                    if (isFramed()) {
                        var opened = null;
                        try {
                            opened = window.open(url, "_top");
                        } catch (e) {
                            opened = null;
                        }
                        if (opened) {
                            return Promise.resolve(true);
                        }
                        log("The browser blocked the sign-in navigation from inside the frame. " +
                            "Open this validator directly (not inside another app) and try again.", true);
                        return Promise.resolve(false);
                    }
                    window.location.href = url;
                    return Promise.resolve(true);
                };
                return client;
            }

            async function initializeMsal(cfg) {
                await loadMsalLibrary();

                if (!msalApp) {
                    msalApp = new msal.PublicClientApplication({
                        auth: {
                            clientId: cfg.clientId,
                            authority: "https://login.microsoftonline.com/" + cfg.tenantId,
                            redirectUri: getRedirectUri(),
                            navigateToLoginRequestUrl: false
                        },
                        cache: {
                            // localStorage is shared with the callback page (same origin) so it can
                            // complete the code exchange with the PKCE verifier this page created.
                            cacheLocation: "localStorage",
                            storeAuthStateInCookie: true
                        },
                        system: {
                            // Skip MSAL's iframe guard; our navigationClient sends the interactive
                            // redirect to the top-level page instead of navigating this frame.
                            allowRedirectInIframe: true,
                            navigationClient: buildNavigationClient()
                        }
                    });
                    await msalApp.initialize();
                }

                return msalApp;
            }

            // Returns an access token if silent works; otherwise starts a full-page
            // redirect (this function will not return in that case).
            async function acquireTokenOrRedirect(cfg, action) {
                if (authInProgress) {
                    throw new Error("A sign-in is already in progress.");
                }

                var app = await initializeMsal(cfg);
                var scopes = getScopes(cfg);
                log("Requesting scopes: " + scopes.join(" "), false);
                log("Redirect URI: " + getRedirectUri(), false);

                // 1) Silent with a cached MSAL account (works after first sign-in).
                var accounts = app.getAllAccounts();
                if (accounts.length > 0) {
                    try {
                        log("Trying acquireTokenSilent (cached account)...", false);
                        var silent = await app.acquireTokenSilent({
                            scopes: scopes,
                            account: accounts[0]
                        });
                        return silent.accessToken;
                    } catch (silentError) {
                        log("Cached silent failed: " + (silentError.errorCode || silentError.message), false);
                    }
                }

                // 2) ssoSilent using your existing AAD session (hidden iframe, prompt=none).
                //    This avoids popup/redirect entirely and works inside the D365 frame.
                try {
                    var loginHint = getLoginHint();
                    log("Trying ssoSilent" + (loginHint ? " (loginHint: " + loginHint + ")" : "") + "...", false);
                    var sso = await app.ssoSilent({
                        scopes: scopes,
                        loginHint: loginHint || undefined
                    });
                    return sso.accessToken;
                } catch (ssoError) {
                    log("ssoSilent failed: " + (ssoError.errorCode || ssoError.message)
                        + " — falling back to interactive redirect.", false);
                }

                // 3) Interactive redirect fallback (full page).
                authInProgress = true;
                saveState(cfg, action);
                log("Redirecting to Microsoft sign-in (full page)...", false);
                await app.acquireTokenRedirect({
                    scopes: scopes,
                    redirectStartPage: getRedirectUri()
                });
                // Page navigates away here; nothing after runs.
                return null;
            }

            function getLoginHint() {
                // ssoSilent needs a hint (UPN/email) to pick the account silently.
                try {
                    var ctx = getD365Context();
                    if (ctx && ctx.userSettings && ctx.userSettings.userName
                        && ctx.userSettings.userName.indexOf("@") > 0) {
                        return ctx.userSettings.userName;
                    }
                } catch (e) {
                    // ignore
                }
                var el = document.getElementById("loginHint");
                return el && el.value ? clean(el.value) : "";
            }

            function decodeJwtPayload(token) {
                try {
                    var parts = token.split(".");
                    if (parts.length < 2) {
                        return null;
                    }
                    var json = atob(parts[1].replace(/-/g, "+").replace(/_/g, "/"));
                    return JSON.parse(json);
                } catch (e) {
                    return null;
                }
            }

            async function callBoomi(cfg, token) {
                var payload = cfg.requestPayload || {};
                var method = (cfg.httpMethod || "POST").toUpperCase();
                var url = cfg.boomiUrl;

                if (method === "GET" || method === "HEAD") {
                    var query = new URLSearchParams(payload);
                    url += (url.indexOf("?") >= 0 ? "&" : "?") + query.toString();
                }

                log("Calling Boomi (" + method + "): " + url, false);
                log("Sending headers: Authorization (Bearer)", false);
                if (method !== "GET" && method !== "HEAD") {
                    log("Body: " + JSON.stringify(payload, null, 2), false);
                }

                var options = {
                    method: method,
                    headers: {
                        "Authorization": "Bearer " + token,
                         "Accept": "text/plain"
                    }
                };
                if (method !== "GET" && method !== "HEAD") {
                    options.headers["Content-Type"] = "application/json";
                    options.body = JSON.stringify(payload);
                }

                var response = await fetch(url, options);
                var body = await response.text();

                if (!response.ok) {
                    throw new Error("Boomi returned " + response.status + ": " + body);
                }

                return {
                    status: response.status,
                    body: body
                };
            }

            function getXrm() {
                if (typeof Xrm !== "undefined") {
                    return Xrm;
                }

                try {
                    // Direct parent only: when opened via main.aspx?pagetype=webresource,
                    // the parent is the D365 shell and exposes Xrm.
                    if (window.parent && window.parent !== window && window.parent.Xrm) {
                        return window.parent.Xrm;
                    }
                } catch (e) {
                    // Cross-origin frame access can throw; ignore and continue.
                }

                return null;
            }

            function getD365Context() {
                try {
                    if (typeof GetGlobalContext === "function") {
                        return GetGlobalContext();
                    }
                } catch (e) {
                    // Continue to Xrm fallback.
                }

                var xrm = getXrm();
                if (xrm && xrm.Utility && xrm.Utility.getGlobalContext) {
                    return xrm.Utility.getGlobalContext();
                }

                return null;
            }

            function normalizeGuid(value) {
                return (value || "").replace(/[{}]/g, "").trim();
            }

            function getPayloadFromTextarea() {
                try {
                    return JSON.parse(document.getElementById("requestPayload").value.trim());
                } catch (e) {
                    return {};
                }
            }

            function setPayload(obj) {
                document.getElementById("requestPayload").value = JSON.stringify(obj, null, 2);
            }

            function prefillFromUrl() {
                var params = new URLSearchParams(window.location.search);
                var userId = normalizeGuid(params.get("userId") || params.get("userid"));
                var oppId = normalizeGuid(params.get("oppID") || params.get("oppid"));

                if (userId || oppId) {
                    var payload = getPayloadFromTextarea();
                    if (userId) {
                        payload.userId = userId;
                        log("Prefilled userId from URL: " + userId, false);
                    }
                    if (oppId) {
                        payload.oppID = oppId;
                        log("Prefilled oppID from URL: " + oppId, false);
                    }
                    setPayload(payload);
                }
            }

            async function prefillFromDynamics() {
                log(VALIDATOR_NAME + " ready.", false);
                prefillFromUrl();

                try {
                    var ctx = getD365Context();
                    if (!ctx || !ctx.userSettings || !ctx.userSettings.userId) {
                        log("D365 context not auto-detected. Enter userId in JSON payload manually, use URL params, or open via main.aspx link above.", false);
                        return;
                    }

                    var currentUserId = normalizeGuid(ctx.userSettings.userId);
                    var payload = getPayloadFromTextarea();
                    if (!payload.userId || payload.userId.indexOf("44444444") === 0) {
                        payload.userId = currentUserId;
                        log("Prefilled userId from D365 context: " + currentUserId, false);
                    }

                    var page = null;
                    try {
                        var xrm = getXrm();
                        if (xrm && xrm.Page && xrm.Page.data && xrm.Page.data.entity) {
                            page = xrm.Page;
                        } else if (window.parent && window.parent.Xrm && window.parent.Xrm.Page) {
                            page = window.parent.Xrm.Page;
                        }
                    } catch (e) {
                        // Ignore frame access errors.
                    }

                    if (!payload.oppID && page && page.data && page.data.entity) {
                        var entityName = page.data.entity.getEntityName();
                        if (entityName === "opportunity") {
                            var oppId = normalizeGuid(page.data.entity.getId());
                            payload.oppID = oppId;
                            log("Prefilled oppID from Opportunity form: " + oppId, false);
                        }
                    }
                    setPayload(payload);
                } catch (e) {
                    log("Could not prefill from D365: " + e.message, true);
                }
            }

            function completeToken(token) {
                showToken(token);
                var claims = decodeJwtPayload(token);
                log("Token validation passed.", false);
                if (claims) {
                    log("aud: " + (claims.aud || ""), false);
                    log("scp: " + (claims.scp || claims.roles || ""), false);
                    log("oid: " + (claims.oid || ""), false);
                    log("appid/azp: " + (claims.appid || claims.azp || ""), false);
                    log("exp: " + (claims.exp ? new Date(claims.exp * 1000).toLocaleString() : ""), false);
                }
            }

            async function completeCall(cfg, token) {
                showToken(token);
                var claims = decodeJwtPayload(token);
                log("Token acquired. scp/roles: " + (claims ? (claims.scp || claims.roles || "") : "n/a"), false);

                var result = await callBoomi(cfg, token);
                log("Boomi integration validation passed. HTTP " + result.status, false);
                log("Response (first 200 chars): " + result.body.substring(0, 20000), false);
                log(VALIDATOR_NAME + " completed successfully.", false);
            }

            // Runs on load. The callback page completes the code exchange and stores the
            // token in localStorage (RESULT_KEY); here we consume it and continue.
            async function handleRedirectReturn() {
                var result = readResult();
                if (!result || !result.accessToken) {
                    return;
                }

                var cfg = readCfgState() || getConfig();
                applyConfigToForm(cfg);
                clearResult();

                try {
                    log("Returned from Microsoft sign-in (token received).", false);
                    if (result.action === "call") {
                        await completeCall(cfg, result.accessToken);
                    } else {
                        completeToken(result.accessToken);
                    }
                } catch (e) {
                    log("Post-sign-in step failed: " + (e.message || e), true);
                }
            }

            async function startup() {
                var riEl = document.getElementById("redirectUri");
                if (riEl && !riEl.value) {
                    riEl.value = getDefaultRedirectUri();
                }

                try {
                    await loadMsalLibrary();
                    log("MSAL loaded from org web resource.", false);
                } catch (e) {
                    log((e.message || e), true);
                }

                if (isFramed()) {
                    log("Note: running inside the D365 frame. Sign-in will navigate the whole page, " +
                        "then return to the redirect URI: " + getRedirectUri(), false);
                }

                await prefillFromDynamics();
                await handleRedirectReturn();
            }

            document.getElementById("btnToken").addEventListener("click", async function () {
                try {
                    var cfg = getConfig();
                    validateConfig(cfg, false);
                    log("Validating MSAL token acquisition...", false);

                    var token = await acquireTokenOrRedirect(cfg, "token");
                    if (token) {
                        completeToken(token);
                    }
                } catch (e) {
                    log("Token validation failed: " + (e.message || e), true);
                }
            });

            document.getElementById("btnCall").addEventListener("click", async function () {
                try {
                    var cfg = getConfig();
                    validateConfig(cfg, true);

                    var manualToken = document.getElementById("manualToken").value.trim();
                    if (manualToken) {
                        log("Using manual token (skipping MSAL)...", false);
                        await completeCall(cfg, manualToken);
                    } else {
                        log("Starting full integration validation...", false);
                        var token = await acquireTokenOrRedirect(cfg, "call");
                        if (token) {
                            await completeCall(cfg, token);
                        }
                    }
                } catch (e) {
                    log("Integration validation failed: " + (e.message || e), true);
                }
            });

            function buildFakeJwt(claims) {
                var header = btoa(JSON.stringify({ alg: "RS256", typ: "JWT" }))
                    .replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
                var payload = btoa(JSON.stringify(claims))
                    .replace(/=/g, "").replace(/\+/g, "-").replace(/\//g, "_");
                return header + "." + payload + ".INVALID_SIGNATURE_FOR_TESTING";
            }

            document.getElementById("btnMalformed").addEventListener("click", async function () {
                try {
                    var cfg = getConfig();
                    validateConfig(cfg, true);

                    var malformedToken = "this-is-not-a-valid-jwt-token-12345";
                    showToken(malformedToken);
                    log("=== MALFORMED TOKEN TEST ===", false);
                    log("Sending a garbage string as Bearer token...", false);
                    log("Expected: Boomi or Function should reject with 401.", false);

                    var result = await callBoomi(cfg, malformedToken);
                    log("Unexpected: Boomi returned HTTP " + result.status + " (expected rejection)", true);
                    log("Response: " + result.body.substring(0, 20000), true);
                } catch (e) {
                    var msg = e.message || String(e);
                    if (msg.indexOf("401") >= 0 || msg.indexOf("403") >= 0) {
                        log("PASS: Malformed token correctly rejected: " + msg, false);
                    } else {
                        log("Result: " + msg, true);
                    }
                }
            });

            document.getElementById("btnExpired").addEventListener("click", async function () {
                try {
                    var cfg = getConfig();
                    validateConfig(cfg, true);

                    var expiredClaims = {
                        aud: "api://" + cfg.apiAppId,
                        iss: "https://login.microsoftonline.com/" + cfg.tenantId + "/v2.0",
                        sub: "test-user@fake.onmicrosoft.com",
                        oid: "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
                        scp: "access_as_user",
                        exp: Math.floor(Date.now() / 1000) - 3600,
                        iat: Math.floor(Date.now() / 1000) - 7200,
                        nbf: Math.floor(Date.now() / 1000) - 7200
                    };
                    var expiredToken = buildFakeJwt(expiredClaims);
                    showToken(expiredToken);
                    log("=== EXPIRED / FAKE SIGNATURE TOKEN TEST ===", false);
                    log("Sending a structurally valid JWT with:", false);
                    log("  - exp: " + new Date(expiredClaims.exp * 1000).toLocaleString() + " (expired)", false);
                    log("  - signature: INVALID (not signed by Microsoft)", false);
                    log("Expected: Function Easy Auth rejects with 401.", false);

                    var result = await callBoomi(cfg, expiredToken);
                    log("Unexpected: Boomi returned HTTP " + result.status + " (expected rejection)", true);
                    log("Response: " + result.body.substring(0, 20000), true);
                } catch (e) {
                    var msg = e.message || String(e);
                    if (msg.indexOf("401") >= 0 || msg.indexOf("403") >= 0) {
                        log("PASS: Expired/fake token correctly rejected: " + msg, false);
                    } else {
                        log("Result: " + msg, true);
                    }
                }
            });

            document.getElementById("btnManualCall").addEventListener("click", async function () {
                try {
                    var manualToken = document.getElementById("manualToken").value.trim();
                    if (!manualToken) {
                        log("Paste a token in the 'Manual Token' field first.", true);
                        return;
                    }

                    var cfg = getConfig();
                    validateConfig(cfg, true);

                    showToken(manualToken);
                    log("=== MANUAL TOKEN END-TO-END TEST ===", false);

                    var claims = decodeJwtPayload(manualToken);
                    if (claims) {
                        log("Token claims:", false);
                        log("  oid: " + (claims.oid || "n/a"), false);
                        log("  upn: " + (claims.upn || claims.preferred_username || "n/a"), false);
                        log("  scp: " + (claims.scp || "n/a"), false);
                        log("  aud: " + (claims.aud || "n/a"), false);
                        log("  exp: " + (claims.exp ? new Date(claims.exp * 1000).toLocaleString() : "n/a"), false);
                        var now = Math.floor(Date.now() / 1000);
                        if (claims.exp && claims.exp < now) {
                            log("  WARNING: Token is EXPIRED (" + Math.round((now - claims.exp) / 60) + " min ago)", true);
                        }
                    } else {
                        log("  (could not decode token claims)", false);
                    }

                    log("Calling Boomi with manual token...", false);
                    var result = await callBoomi(cfg, manualToken);
                    log("SUCCESS: Boomi returned HTTP " + result.status, false);
                    log("Response: " + result.body.substring(0, 30000), false);
                } catch (e) {
                    log("FAILED: " + (e.message || e), true);
                }
            });

            document.getElementById("btnClear").addEventListener("click", function () {
                logEl.textContent = "";
                logEl.className = "";
                showToken(null);
            });

            startup();
        })();
    </script>
</body>
</html>
