//Function will be called on change of parentcontactid(Contact) field.
function ClearLeadFields(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        formContext.ui.clearFormNotification("ErrorMessage");
		 if (formContext.getAttribute("parentcontactid").getValue() === null || formContext.getAttribute("parentcontactid").getValue() === undefined) {
			formContext.getAttribute("firstname").setValue(null);
			formContext.getAttribute("lastname").setValue(null);
			formContext.getAttribute("telephone1").setValue(null);
			formContext.getAttribute("telephone2").setValue(null);
			formContext.getAttribute("mobilephone").setValue(null);
			formContext.getAttribute("emailaddress1").setValue(null);
		 }
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function ClearLeadFields(LeadMobile.js)" + (error.description || error.message));
    }
}

//On Change Contact Set fields on lead from contact.
function OnChangeContactLookup(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("parentcontactid").getValue() !== null && formContext.getAttribute("parentcontactid").getValue() !== undefined) {
            var contact = formContext.getAttribute("parentcontactid").getValue();
            var contactId = contact[0].id.replace('{', '').replace('}', '');
            var req = new XMLHttpRequest();
            var globalContext = Xrm.Utility.getGlobalContext();
            req.open("GET", globalContext.getClientUrl() + "/api/data/v9.2/contacts(" + contactId + ")?$select=firstname,lastname,telephone1,telephone2,mobilephone,emailaddress1", true);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Prefer", "odata.include-annotations=*");
            req.onreadystatechange = function () {
                if (this.readyState === 4) {
                    req.onreadystatechange = null;
                    if (this.status === 200) {
                        var result = JSON.parse(this.response);
                        var contactFirstName = result["firstname"];
                        var contactLastName = result["lastname"];
                        if (contactFirstName !== null) {
                            formContext.getAttribute("firstname").setValue(contactFirstName);
                        }
						else {
							formContext.getAttribute("firstname").setValue(null);
						}
						if(contactLastName !== null)
						{
							formContext.getAttribute("lastname").setValue(contactLastName);
						}
						else {
							formContext.getAttribute("lastname").setValue(null);
						}
						if(result["telephone1"] !== null)
						{
							formContext.getAttribute("telephone1").setValue(result.telephone1);
						}
						else {
							formContext.getAttribute("telephone1").setValue(null);
						}
						if(result["telephone2"] !== null)
						{
							formContext.getAttribute("telephone2").setValue(result.telephone2);
						}
						else {
							formContext.getAttribute("telephone2").setValue(null);
						}
						if(result["mobilephone"] !== null)
						{
							formContext.getAttribute("mobilephone").setValue(result.mobilephone);
						}
						else {
							formContext.getAttribute("mobilephone").setValue(null);
						}
						if(result["emailaddress1"] !== null)
						{
							formContext.getAttribute("emailaddress1").setValue(result.emailaddress1);
						}
						else {
							formContext.getAttribute("emailaddress1").setValue(null);
						}
						formContext.data.save();
                    } else {
                        DisplayAlertMessage("ERROR", "Error At function OnChangeContactLookup(LeadMobile.js)" + (error.description || error.message));
                    }
                }
            };
            req.send();
        }
		else{
			ClearLeadFields(executionContext);
		}
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function OnChangeContactLookup(LeadMobile.js)" + (error.description || error.message));
    }
}


function setLeadTypeForOnPageLoadForRoles(executionContext)
{
    "use strict";
    var formContext = executionContext.getFormContext();
    if(formContext !== "undefined" && formContext !== null)
    {

    var userRoles = Xrm.Utility.getGlobalContext().userSettings.roles;
   
    if (userRoles !== null && userRoles !== undefined) {
        userRoles.forEach(function (item) {
            if (item.name.toLowerCase() === "insurance leader" || item.name.toLowerCase() === "insurance sales" || item.name.toLowerCase() === "agency support") {
                formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Insurance);
				return ;
            }
            else if (item.name.toLowerCase() === "fraternal manager" ) {
                formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Fraternal);
				return ;
            }
            else if (item.name.toLowerCase() === "charity leader" || item.name.toLowerCase() === "charity user") {
                formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Charity);
				return ;
            }//changed 2.0
            else if (item.name.toLowerCase() === "investment manager" || item.name.toLowerCase() === "investment support" || item.name.toLowerCase() === "investment leaderâ€‹â€‹") {
                formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.InstitutionalInvestment);
				return ;
            }
            else if (item.name.toLowerCase() === "retail investment sales" ) {
                formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.RetailInvestment);
				return ;
            }
            else if (item.name.toLowerCase() === "kccf leader"|| item.name.toLowerCase() === "kccf user" ) {
