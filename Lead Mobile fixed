//Function to Filter Lead Subtype Based on Lead Type
function FilterLeadSubTypeMobile(executionContext) {
    "use strict";
    try {
		
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_leadtype").getValue() !== null) {
			if(formContext.ui.getFormType()===1 && formContext.getAttribute("kofc_leadsubtype").getValue()!==null)
			{
				formContext.getAttribute("kofc_leadsubtype").setValue(null);
			}
            var leadType = formContext.getAttribute("kofc_leadtype").getValue();
            //Apply Search on lookup field OnClick 
            formContext.getControl("kofc_leadsubtype").addPreSearch(function () {
                var leadType = formContext.getAttribute("kofc_leadtype").getValue();
                //Apply the filter condition
                var filter = "<filter type='and'><condition attribute='kofc_leadtype' operator='eq' value='" + leadType + "' /></filter>";
                //Populate the filter values into lookup field
                formContext.getControl("kofc_leadsubtype").addCustomFilter(filter);
            });
        }
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function FilterLeadSubTypeMobile" + (error.description || error.message));
    }

}

//Function to Set Lead Type Disabled for recruiting.
function MakeLeadTypeDisabled(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_leadtype").getValue() !== null && formContext.getAttribute("kofc_leadtype").getValue() !== undefined) {
            var leadType = formContext.getAttribute("kofc_leadtype").getValue();
            if (leadType === optionSetValues.Recruiting) {
                formContext.getControl("kofc_leadtype").setDisabled(true);
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog("Error At function MakeLeadTypeDisabled: " + (error.description || error.message));
    }
}

function OnChangePhoneNumber(executionContext, attributeSchema) {
    "use strict";
    try {
		
        var formContext = executionContext.getFormContext();
        var phoneNumberPattern = /^\(\d{3}\) \d{3}-\d{4}$/;
        var phone = formContext.getAttribute(attributeSchema).getValue(); //get Phone value
        formContext.getControl(attributeSchema).clearNotification("PhoneError");
        if (phone !== null && !phoneNumberPattern.test(phone)) {
            if (phone !== null && (phone.length < 10 || phone.length > 10 || isNaN(phone))) {
				var tenDigitNumericValueKeyMessage = Xrm.Utility.getResourceString(Messages.Resource, Messages.TenDigitNumericValueKey);
                formContext.getControl(attributeSchema).setNotification(tenDigitNumericValueKeyMessage, "PhoneError");            
            }
            else {
                formContext.getControl(attributeSchema).clearNotification("PhoneError");
                formContext.getAttribute(attributeSchema).setValue("(" + phone.substr(0, 3) + ") " + phone.substr(3, 3) + "-" + phone.substr(6, phone.length));
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog("Error At function OnChangePhoneNumber" + (error.description || error.message));
    }
}

