    /// <summary>
    /// Contact, Create and Update, PreOperation (20), Synchronous.
    /// Update filtering attributes: telephone1, telephone2, mobilephone.
    /// Update pre-image "PreImage": address1_country, telephone1, telephone2, mobilephone.
    /// Unsecure configuration (optional): logical name of a boolean "needs review" column.
    /// </summary>
    public class ContactPhoneNormalizationPlugin : IPlugin
    {
        private const string PluginName = "ContactPhoneNormalizationPlugin";
        private const string PreImageName = "PreImage";
        private const string CountryField = "address1_country";
        private static readonly string[] PhoneFields = { "telephone1", "telephone2", "mobilephone" };

        // true = trace full phone numbers (DEV troubleshooting only); false = mask all but the last 4 digits.
        private static readonly bool LogFullPhoneNumbers = false;

        private readonly string reviewFlagField;

        public ContactPhoneNormalizationPlugin(string unsecureConfig, string secureConfig)
        {
            reviewFlagField = string.IsNullOrWhiteSpace(unsecureConfig) ? null : unsecureConfig.Trim();
        }

        public void Execute(IServiceProvider serviceProvider)
        {
            var tracing = (ITracingService)serviceProvider.GetService(typeof(ITracingService));
            var context = (IPluginExecutionContext)serviceProvider.GetService(typeof(IPluginExecutionContext));
            var timer = Stopwatch.StartNew();

            Log(tracing, "Start. Message={0}, Stage={1}, Mode={2}, Depth={3}, RecordId={4}, UserId={5}, CorrelationId={6}",
                context.MessageName, context.Stage, context.Mode, context.Depth,
                context.PrimaryEntityId, context.InitiatingUserId, context.CorrelationId);

            try
            {
                if (context.Stage != 20 ||
                    (context.MessageName != "Create" && context.MessageName != "Update") ||
                    !context.InputParameters.Contains("Target"))
                {
                    Log(tracing, "Skipped: expected a PreOperation Create or Update with a Target.");
                    return;
                }
                var target = context.InputParameters["Target"] as Entity;
                if (target == null || target.LogicalName != "contact")
                {
                    Log(tracing, "Skipped: Target is not a contact ({0}).", target == null ? "null" : target.LogicalName);
                    return;
                }

                var preImage = context.PreEntityImages.Contains(PreImageName) ? context.PreEntityImages[PreImageName] : null;
                if (context.MessageName == "Update" && preImage == null)
                {
                    Log(tracing, "Warning: pre-image '{0}' is not registered; country and review flag use Target values only.", PreImageName);
                }

                var countryText = GetCurrentValue(target, preImage, CountryField);
                var region = CountryResolver.Resolve(countryText);
                Log(tracing, "Country '{0}' resolved to region {1}.", countryText ?? "(blank)", region ?? "none");

                var phoneInTarget = false;
                foreach (var field in PhoneFields)
                {
                    if (!target.Contains(field))
                    {
                        continue;
                    }
                    phoneInTarget = true;
                    var value = target.GetAttributeValue<string>(field);
                    if (string.IsNullOrWhiteSpace(value))
                    {
                        Log(tracing, "{0}: blank, nothing to normalize.", field);
                        continue;
                    }
                    var result = PhoneNormalizer.Normalize(value, region);
                    if (!result.IsValid)
                    {
                        Log(tracing, "{0}: '{1}' could not be normalized; left unchanged.", field, Mask(value));
                        continue;
                    }
                    if (result.Stored == value)
                    {
                        Log(tracing, "{0}: '{1}' already normalized.", field, Mask(value));
                        continue;
                    }
                    target[field] = result.Stored;
                    Log(tracing, "{0}: '{1}' -> '{2}'.", field, Mask(value), Mask(result.Stored));
                }

                if (!phoneInTarget)
                {
                    Log(tracing, "No phone fields in Target; nothing to do.");
                }
                else if (reviewFlagField != null)
                {
                    var needsReview = NeedsReview(target, preImage, region);
                    target[reviewFlagField] = needsReview;
                    Log(tracing, "{0} set to {1}.", reviewFlagField, needsReview);
                }
            }
            catch (Exception ex)
            {
                // Fail open: never block a create/update (e.g. a Snowflake load) because of phone formatting.
                Log(tracing, "Error, save continues without phone normalization: {0}", ex.ToString());
            }
            finally
            {
                Log(tracing, "End. Duration={0} ms.", timer.ElapsedMilliseconds);
            }
        }

        private static bool NeedsReview(Entity target, Entity preImage, string region)
        {
            foreach (var field in PhoneFields)
            {
                var value = GetCurrentValue(target, preImage, field);
                if (!string.IsNullOrWhiteSpace(value) && !PhoneNormalizer.Normalize(value, region).IsValid)
                {
                    return true;
                }
            }
            return false;
        }

        private static string GetCurrentValue(Entity target, Entity preImage, string field)
        {
            if (target.Contains(field))
            {
                return target.GetAttributeValue<string>(field);
            }
            return preImage != null && preImage.Contains(field) ? preImage.GetAttributeValue<string>(field) : null;
        }

        // Masks all digits except the last 4, keeping formatting characters so the change is still visible.
        private static string Mask(string value)
        {
            if (LogFullPhoneNumbers || string.IsNullOrEmpty(value))
            {
                return value;
            }
            var chars = value.ToCharArray();
            var digitsSeen = 0;
            for (var i = chars.Length - 1; i >= 0; i--)
            {
                if (char.IsDigit(chars[i]) && ++digitsSeen > 4)
                {
                    chars[i] = '*';
                }
            }
            return new string(chars);
        }

        private static void Log(ITracingService tracing, string format, params object[] args)
        {
            if (tracing != null)
            {
                tracing.Trace(PluginName + ": " + format, args);
            }
        }
    }

    public sealed class PhoneResult
    {
        public bool IsValid { get; private set; }
        public string Stored { get; private set; }

        public static readonly PhoneResult Invalid = new PhoneResult { IsValid = false };

        public static PhoneResult Valid(string stored)
        {
            return new PhoneResult { IsValid = true, Stored = stored };
        }
    }

    public static class PhoneNormalizer
    {
        public const int MinDigits = 7;
        private static readonly bool StrictValidation = false;

        private const string UnknownRegion = "ZZ";
        private static readonly PhoneNumberUtil Util = PhoneNumberUtil.GetInstance();
        private static readonly Regex NonDigits = new Regex(@"\D", RegexOptions.Compiled);
        private static readonly Regex NanpTollFree = new Regex(@"^1?(800|833|844|855|866|877|888)\d{7}$", RegexOptions.Compiled);
        private static readonly Regex FirstLetter = new Regex(@"[a-z]", RegexOptions.Compiled | RegexOptions.IgnoreCase);

        public static PhoneResult Normalize(string value, string defaultRegion)
        {
            if (string.IsNullOrWhiteSpace(value))
            {
                return PhoneResult.Invalid;
            }
            var text = value.Trim();
            if (text.StartsWith("00", StringComparison.Ordinal))
            {
                text = "+" + text.Substring(2).Trim();
            }
            if (NonDigits.Replace(text, "").Length < MinDigits)
            {
                return PhoneResult.Invalid;
            }
            var phone = Parse(text, defaultRegion);
            if (phone == null || !(StrictValidation ? Util.IsValidNumber(phone) : Util.IsPossibleNumber(phone)))
            {
                return PhoneResult.Invalid;
            }
            var stored = Util.Format(phone, PhoneNumberFormat.E164);
            if (phone.HasExtension && !string.IsNullOrEmpty(phone.Extension))
            {
                stored += " x" + phone.Extension;
            }
            return PhoneResult.Valid(stored);
        }

        private static PhoneNumber Parse(string text, string defaultRegion)
        {
            if (text.StartsWith("+", StringComparison.Ordinal))
            {
                return TryParse(text, UnknownRegion);
            }
            var mainDigits = NonDigits.Replace(FirstLetter.Split(text)[0], "");
            if (NanpTollFree.IsMatch(mainDigits))
            {
                return TryParse(text, "US");
            }
            var national = defaultRegion != null ? TryParse(text, defaultRegion) : null;
            if (national != null && Util.IsValidNumber(national))
            {
                return national;
            }
            var international = TryParse("+" + text, UnknownRegion);
            if (international != null && Util.IsValidNumber(international))
            {
                return international;
            }
            return national;
        }

        private static PhoneNumber TryParse(string text, string region)
        {
            try
            {
                return Util.Parse(text, region);
            }
            catch (NumberParseException)
            {
                return null;
            }
        }
    }

