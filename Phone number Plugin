        private static readonly Dictionary<string, string> Lookup = BuildLookup();

        public static string Resolve(string countryText)
        {
            if (string.IsNullOrWhiteSpace(countryText))
            {
                return null;
            }
            string code;
            return Lookup.TryGetValue(NormalizeKey(countryText), out code) ? code : null;
        }

        public static string NormalizeKey(string text)
        {
            var decomposed = text.Normalize(NormalizationForm.FormD);
            var builder = new StringBuilder(decomposed.Length);
            foreach (var c in decomposed)
            {
                if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                {
                    builder.Append(c);
                }
            }
            var lower = builder.ToString().ToLowerInvariant().Replace(".", "");
            return NonLetters.Replace(lower, " ").Trim();
        }

        private static Dictionary<string, string> BuildLookup()
        {
            var lookup = new Dictionary<string, string>();
            foreach (var code in Names.Values.Distinct())
            {
                lookup[code.ToLowerInvariant()] = code;
            }
            foreach (var pair in Names)
            {
                lookup[pair.Key] = pair.Value;
            }
            foreach (var pair in Aliases)
            {
                lookup[pair.Key] = pair.Value;
            }
            return lookup;
        }
