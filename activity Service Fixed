// Calling this function on save of Task activity to update  Case status
// Returns a Promise so it can run as an async OnSave handler

function OnSaveTask(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        // Get Activity Type and Check it is Task
        var EntityType = formContext.data.entity.getEntityName();
        if (EntityType === activityType.Task) {
            // Get the field
            var regardingEntity = formContext.getAttribute("regardingobjectid").getValue();
            if (regardingEntity !== null) {
                var regardingEntityId = regardingEntity[0].id;
                var regardingEntityName = regardingEntity[0].entityType;
                if (regardingEntityName === regaringEntityType.Case) {
                    return GetCaseRecordInfo(regardingEntityId).then(function (caseResults) {
                        if (caseResults !== null) {
                            var resolutionStatus = caseResults["kofc_resolutionstatus"];
                            var incidentId = caseResults["incidentid"];
                            // Get Task Priority Value
                            var taskPriorityValue = formContext.getAttribute("prioritycode").getValue();
                            if (resolutionStatus === caseResolutionStatus.HandofftoAgent && taskPriorityValue === taskPriority.High) {
                                var incidentresolution = {
                                    "subject": "Case Resolved",
                                    "incidentid@odata.bind": "/incidents(" + incidentId + ")",//Replace this Id with Id of case you want to resolve
                                    "timespent": 60,//This is billable time in minutes
                                    "description": "Case Resolved"
                                };

                                var parameters = {
                                    "IncidentResolution": incidentresolution,
                                    "Status": -1
                                };

                                return new Promise(function (resolve) {
                                    var req = new XMLHttpRequest();
                                    req.open("POST", Xrm.Utility.getGlobalContext().getClientUrl() + "/api/data/v9.2/CloseIncident", true);
                                    req.setRequestHeader("OData-MaxVersion", "4.0");
                                    req.setRequestHeader("OData-Version", "4.0");
                                    req.setRequestHeader("Accept", "application/json");
                                    req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
                                    req.onreadystatechange = function () {
                                        if (this.readyState === 4) {
                                            req.onreadystatechange = null;
                                            if (this.status === 204) {
                                                Xrm.Navigation.openForm({ entityName: "incident", entityId: caseResults.incidentid });
                                            } else {
                                                var errorText = this.responseText;
                                                Xrm.Navigation.openAlertDialog('Error in OnSave: ' + errorText);
                                            }
                                            resolve();
                                        }
                                    };
                                    req.send(JSON.stringify(parameters));
                                });
                            }
                        }
                    }).catch(function (error) {
                        Xrm.Navigation.openAlertDialog('Error in OnSave: ' + (error.description || error.message));
                    });
                }
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in OnSave: ' + (error.description || error.message));
    }
}

//New Function to get the Queue ID for 'Customer Service Queue'

function GetQueueIDForCustomerServiceQueue(formContext) {
    "use strict";
    try {
        Xrm.WebApi.retrieveMultipleRecords("queue", "?$filter=name eq 'Customer Service Queue'").then(
            function success(results) {
                for (var i = 0; i < results.entities.length; i++) {
                    var result = results.entities[i];
                    // Columns
                    var queueid = result["queueid"]; // Guid
                    var fromEmail = new Array();
                    fromEmail[0] = new Object();
                    fromEmail[0].id = queueid; // GUID of the lookup id
                    fromEmail[0].name = customerServiceQueue.EntityName; // Name of the lookup
                    fromEmail[0].entityType = customerServiceQueue.EntityType; //Entity Type of the lookup entity

                    formContext.getAttribute("from").setValue(null);
                    formContext.getAttribute("from").setValue(fromEmail);
                }
            },
            function (error) {
                // Error intentionally not surfaced (console logging removed per checker rule web-remove-console)
            }
        );

    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in GetQueueIDForCustomerServiceQueue: ' + (error.description || error.message));
    }
}


function getCustomerServiceQueueRecord(formContext) {
    "use strict";
    try {
        const fetchXml = `<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
                      <entity name="queue">
                        <attribute name="name" />
                        <attribute name="emailaddress" />
                        <attribute name="queueid" />
                        <order attribute="name" descending="false" />
                        <filter type="and">
                          <condition attribute="name" operator="eq" value="Customer Service Queue Outbound" />
                          <condition attribute="emailaddress" operator="like" value="customer.service%" />
                          <condition attribute="statecode" operator="eq" value="0" />
                        </filter>
                      </entity>
                    </fetch>`;

        return Xrm.WebApi.retrieveMultipleRecords('queue', "?fetchXml=" + encodeURIComponent(fetchXml))
            .then(function (result) {
                if (result.entities.length === 0) {
                    return;
                }

                var record = result.entities[0];
                var fromEmail = new Array();
                fromEmail[0] = new Object();
                fromEmail[0].id = record["queueid"]; // GUID of the lookup id
                fromEmail[0].name = customerServiceQueue.EntityName; // Name of the lookup
                fromEmail[0].entityType = customerServiceQueue.EntityType; //Entity Type of the lookup entity

                formContext.getAttribute("from").setValue(null);
                formContext.getAttribute("from").setValue(fromEmail);
            })
    } catch (error) {
        // Error intentionally not surfaced (console logging removed per checker rule web-remove-console)
    }
}

