// Generic Funtion to get Case record details
// Returns a Promise that resolves with the case record (asynchronous call)
function GetCaseRecordInfo(caseId) {
    "use strict";
    try {
        return Xrm.WebApi.retrieveRecord("incident", caseId.slice(1, -1), "?$select=ticketnumber,kofc_resolutionstatus");
    }
    catch (err) {
        formContext.ui.setFormNotification("Error in QuickCreateOnLoad" + err.message, ERROR, "ErrorMessage");
        return false;
    }
}

function QuickCreateOnLoad(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        formContext.ui.clearFormNotification("ErrorMessage");
        var parentRecordReference = Xrm.Utility.getPageContext().input.createFromEntity;
        //if this variable is null then Quick Create Form was called from the Global Menu
        //or from some other code without setting the parent record context
        if (parentRecordReference === null) {
            return;
        }
        Xrm.WebApi.retrieveRecord(parentRecordReference.entityType, parentRecordReference.id, "?$select=name,kofc_opportunitytype").then(

            function success(result) {
                if (result.kofc_opportunitytype === opportunityType.Charity) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.Charity);
                }
                if ((result.kofc_opportunitytype === opportunityType.CouncilReactivation) || (result.kofc_opportunitytype === opportunityType.NewCouncilDevelopment) || (result.kofc_opportunitytype === opportunityType.NewMember) || (result.kofc_opportunitytype === opportunityType.EstablishCor)) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.Fraternal);
                }
                if (result.kofc_opportunitytype === opportunityType.InstitutionalInvestment) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.InstitutionalInvestment);
                }
                if (result.kofc_opportunitytype === opportunityType.RetailInvestment) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.RetailInvestment);
                }
                if (result.kofc_opportunitytype === opportunityType.NeedInsurance) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.Insurance);
                }
                if (result.kofc_opportunitytype === opportunityType.KCCF) {
                    SetActivityForSelectedOpportunityType(formContext, activityFor.KCCF);
                }

            },
            function (error) {
                formContext.ui.setFormNotification(err.message, ERROR, "ErrorMessage");
                return false;
            });

        // US 19095 added by Bheemesh
        SetTaskDueDateBaseedonCaseResolutionStasus(executionContext);
    }
    catch (err) {
        formContext.ui.setFormNotification("Error in QuickCreateOnLoad" + err.message, ERROR, "ErrorMessage");
        return false;
    }
}

function SetActivityForSelectedOpportunityType(formContext, activityForType) {
    "use strict";
    formContext.getControl('kofc_activityfor').getAttribute().setValue(activityForType);
    if (formContext.getControl('kofc_activityfor') !== null) {
        formContext.getControl('kofc_activitytypevalue').addPreSearch(AddActivityType);
        formContext.getControl('kofc_activityfor').setDisabled(true);
    }
    else {
        formContext.getControl('kofc_activityfor').setDisabled(false);
    }
}

