// US:19095
// Calling this function on load of Task activity
function SetTaskDueDateBaseedonCaseResolutionStasus(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        // Get Activity Type and Check it is Task
        var EntityType = formContext.data.entity.getEntityName();
        if (EntityType === activityType.Task) {
            // Get the field
            var regardingEntity = formContext.getAttribute("regardingobjectid").getValue();
            if (regardingEntity !== null) {
                var regardingEntityId = regardingEntity[0].id;
                var regardingEntityName = regardingEntity[0].entityType;
                if (regardingEntityName === regaringEntityType.Case) {
                    GetCaseRecordInfo(regardingEntityId).then(function (caseResults) {
                        if (caseResults !== null) {
                            var resolutionStatus = caseResults["kofc_resolutionstatus"];
                            if (resolutionStatus === caseResolutionStatus.EscalatedtoAgents) {
                                var date = new Date();
                                //add 24 hours to current date
                                date.setHours(date.getHours() + 24);
                                // Update Due Date of Task for the Case 
                                formContext.getAttribute("scheduledend").setValue(date);
                                //formContext.getAttribute("prioritycode").setValue(taskPriority.High);
                            }
                            if (resolutionStatus === caseResolutionStatus.HandofftoAgent) {
                                var date = new Date();
                                //add 24 hours to current date
                                date.setHours(date.getHours() + 48);
                                // Update Due Date of Task for the Case 
                                formContext.getAttribute("scheduledend").setValue(date);
                                // formContext.getAttribute("prioritycode").setValue(taskPriority.High);
                            }
                        }
                    }).catch(function (error) {
                        Xrm.Navigation.openAlertDialog('Error in SetTaskDueDateBaseedonCaseResolutionStasus: ' + (error.description || error.message));
                    });
                }
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in SetTaskDueDateBaseedonCaseResolutionStasus: ' + (error.description || error.message));
    }
}

