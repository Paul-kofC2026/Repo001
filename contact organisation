//Function to map organization type from organization entity on change of organization lookup on Contact organization Relationship entity

function MapOrgTypeOfOrgChange(executionContext) {
    "use strict";
    var formContext = executionContext.getFormContext();
    var eventArguments = executionContext.getEventArgs();
    try {
        if (formContext.getAttribute("kofc_organization").getValue() !== null && formContext.getAttribute("kofc_organization").getValue() !== undefined) {
            var organisation = formContext.getAttribute("kofc_organization").getValue();
            var orgID = organisation[0].id.replace('{', '').replace('}', '');
            var req = new XMLHttpRequest();
            req.open("GET", Xrm.Utility.getGlobalContext().getClientUrl() + "/api/data/v9.2/kofc_organizations(" + orgID + ")?$select=kofc_organizationtype", false);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Prefer", "odata.include-annotations=*");
            req.onreadystatechange = function () {
                if (this.readyState === 4) {
                    req.onreadystatechange = null;
                    if (this.status === 200) {
                        var result = JSON.parse(this.response);
                        var kofc_organizationid = result["kofc_organizationid"]; // Guid
                        var kofc_organizationtype = result["kofc_organizationtype"]; // Choice
                        var kofc_organizationtype_formatted = result["kofc_organizationtype@OData.Community.Display.V1.FormattedValue"];
                        if (kofc_organizationtype !== null && kofc_organizationtype !== undefined) {
                            formContext.getAttribute('kofc_organizationtype').setValue(kofc_organizationtype);
                            FilterOrganizationRoles(executionContext);
                        }
                        else {
                            formContext.getAttribute('kofc_organizationtype').setValue(null);
                        }
                    } else {

                    }
                }
            };
            req.send();
        }
    }


    catch (error) {
        Xrm.Navigation.openAlertDialog("ERROR", "Error At function MapOrgTypeOfOrgChange" + (error.description || error.message));
    }
}
