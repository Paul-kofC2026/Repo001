//Function to check roles if matched then the restriction should be shown for contact-org relationship creation.

function CheckInsuranceRoles() {
    "use strict";
    var roles = Xrm.Utility.getGlobalContext().userSettings.roles;
    var hasRole = false;
    if (roles !== null && roles !== undefined) {
        roles.forEach(function (item) {
            if (item.name.toLowerCase() === "agency support" || item.name.toLowerCase() === "home office" || item.name.toLowerCase() === "insurance leader" || item.name.toLowerCase() === "insurance sales" ) {
                hasRole = true;
                return hasRole;
            }
        });
    }
    return hasRole;
}



