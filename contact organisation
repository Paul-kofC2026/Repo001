//Function to Filter Lead Subtype Based on Lead Type
function FilterOrganizationRoles(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_organizationtype").getValue() !== null) {
            var organizationType = formContext.getAttribute("kofc_organizationtype").getValue();
            //Apply Search on lookup field OnClick 
            formContext.getControl("kofc_organizationroles").addPreSearch(function () {
                var organizationType = formContext.getAttribute("kofc_organizationtype").getValue();
                //Apply the filter condition
                var filter = "<filter type='and'><condition attribute='kofc_organizationtype' operator='eq' value='" + organizationType + "' /></filter>";
                //Populate the filter values into lookup field
                formContext.getControl("kofc_organizationroles").addCustomFilter(filter);
            });
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog("ERROR", "Error At function FilterOrganizationRoles" + (error.description || error.message));
    }

}



