var ContactPhoneManager = (function () {
    "use strict";

    const PHONE_FIELDS = [
        "telephone1",     // Business Phone
        "telephone2",     // Home Phone
        "mobilephone"     // Mobile Phone
    ];

    const ERROR_ID = "PhoneValidation";

    /**
     * Form OnLoad
     */
    function onLoad(executionContext) {

        const formContext = executionContext.getFormContext();

        PHONE_FIELDS.forEach(function (fieldName) {
            formatField(formContext, fieldName);
        });
    }

    /**
     * Field OnChange
     */
    function onPhoneChange(executionContext) {

        const formContext = executionContext.getFormContext();
        const attribute = executionContext.getEventSource();

        if (!attribute) {
            return;
        }

        const fieldName = attribute.getName();

        clearValidation(formContext, fieldName);

        if (!validatePhone(formContext, fieldName)) {
            return;
        }

        formatField(formContext, fieldName);
    }

    /**
     * Form OnSave
     */
    function onSave(executionContext) {

        const formContext = executionContext.getFormContext();
        const eventArgs = executionContext.getEventArgs();

        let hasErrors = false;

        PHONE_FIELDS.forEach(function (fieldName) {

            clearValidation(formContext, fieldName);

            if (!validatePhone(formContext, fieldName)) {
                hasErrors = true;
            }
        });

        if (hasErrors) {
            eventArgs.preventDefault();
        }
    }

    /**
     * Validation
     */
    function validatePhone(formContext, fieldName) {

        const attribute = formContext.getAttribute(fieldName);
        const control = formContext.getControl(fieldName);

        if (!attribute || !control) {
            return true;
        }

        const value = attribute.getValue();

        if (!value) {
            return true;
        }

        const digits = value.replace(/\D/g, "");

        if (digits.length < 7) {

            control.setNotification(
                "Phone number must contain a valid country code and telephone number.",
                ERROR_ID
            );

            return false;
        }

        return true;
    }

    /**
     * Remove previous validation message
     */
    function clearValidation(formContext, fieldName) {

        const control = formContext.getControl(fieldName);

        if (control) {
            control.clearNotification(ERROR_ID);
        }
    }

    /**
     * Display formatting only
     */
    function formatField(formContext, fieldName) {

        const attribute = formContext.getAttribute(fieldName);

        if (!attribute) {
            return;
        }

        const value = attribute.getValue();

        if (!value) {
            return;
        }

        const formattedValue = formatPhone(value);

        if (formattedValue !== value) {
            attribute.setValue(formattedValue);
        }
    }

    /**
     * Formats:
     * +12245221234 -> (224) 522-1234
     * 2245221234 -> (224) 522-1234
     */
    function formatPhone(phone) {

        if (!phone) {
            return phone;
        }

        const digits = phone.replace(/\D/g, "");

        // North America - E.164
        if (digits.length === 11 && digits.startsWith("1")) {

            return "(" +
                digits.substring(1, 4) +
                ") " +
                digits.substring(4, 7) +
                "-" +
                digits.substring(7);
        }

        // Legacy North America
        if (digits.length === 10) {

            return "(" +
                digits.substring(0, 3) +
                ") " +
                digits.substring(3, 6) +
                "-" +
                digits.substring(6);
        }

        // International numbers remain unchanged
        return phone;
    }

    return {
        onLoad: onLoad,
        onPhoneChange: onPhoneChange,
        onSave: onSave
    };

})();
