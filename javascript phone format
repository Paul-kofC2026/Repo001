    let countryLookup = null;

    function onLoad(executionContext) {
        try {
            const formContext = executionContext.getFormContext();
            if (!getLibrary()) {
                console.warn(LOG_PREFIX + "libphonenumber is not loaded. Only the minimum-length check will run.");
            }
            if (!FORMAT_ON_LOAD || formContext.ui.getFormType() === FORM_TYPE_BULK_EDIT) {
                return;
            }
            applyDisplayFormat(formContext);
            formContext.data.removeOnLoad(onDataLoad);
            formContext.data.addOnLoad(onDataLoad);
        } catch (error) {
            logError("onLoad", error);
        }
    }

    function onDataLoad(executionContext) {
        try {
            applyDisplayFormat(executionContext.getFormContext());
        } catch (error) {
            logError("onDataLoad", error);
        }
    }

    function onPhoneChange(executionContext) {
        try {
            const formContext = executionContext.getFormContext();
            const attribute = executionContext.getEventSource();
            if (!attribute) {
                return;
            }
            attribute.setSubmitMode("always");
            clearFieldError(attribute);
            const value = attribute.getValue();
            if (!value) {
                return;
            }
            const result = analyzePhone(value, getDefaultCountry(formContext));
            if (!result.valid) {
                setFieldError(attribute);
                return;
            }
            if (result.display !== value) {
                attribute.setValue(result.display);
            }
        } catch (error) {
            logError("onPhoneChange", error);
        }
    }

    function onCountryChange(executionContext) {
        try {
            const formContext = executionContext.getFormContext();
            const country = getDefaultCountry(formContext);
            PHONE_FIELDS.forEach(function (fieldName) {
                const attribute = formContext.getAttribute(fieldName);
                if (!attribute ||
                    attribute.getSubmitMode() === "never" ||
                    !attribute.getIsDirty() ||
                    !isEditable(attribute)) {
                    return;
                }
                clearFieldError(attribute);
                const value = attribute.getValue();
                if (!value) {
                    return;
                }
                const result = analyzePhone(value, country);
                if (!result.valid) {
                    setFieldError(attribute);
                    return;
                }
                if (result.display !== value) {
                    attribute.setValue(result.display);
                }
            });
        } catch (error) {
            logError("onCountryChange", error);
        }
    }

    function onSave(executionContext) {
        try {
            const formContext = executionContext.getFormContext();
            const eventArgs = executionContext.getEventArgs();
            const country = getDefaultCountry(formContext);
            let hasErrors = false;
            PHONE_FIELDS.forEach(function (fieldName) {
                const attribute = formContext.getAttribute(fieldName);
                if (!attribute ||
                    attribute.getSubmitMode() === "never" ||
                    !attribute.getIsDirty() ||
                    !isEditable(attribute)) {
                    return;
                }
                clearFieldError(attribute);
                const value = attribute.getValue();
                if (!value) {
                    return;
                }
                const result = analyzePhone(value, country);
                if (!result.valid) {
                    setFieldError(attribute);
                    hasErrors = true;
                    return;
                }
                if (result.stored !== value) {
                    attribute.setValue(result.stored);
                }
            });
            if (hasErrors && eventArgs) {
                eventArgs.preventDefault();
            }
        } catch (error) {
            logError("onSave", error);
        }
    }

    function applyDisplayFormat(formContext) {
        const country = getDefaultCountry(formContext);
        PHONE_FIELDS.forEach(function (fieldName) {
            const attribute = formContext.getAttribute(fieldName);
            if (!attribute || (attribute.getIsDirty() && attribute.getSubmitMode() !== "never")) {
                return;
            }
            clearFieldError(attribute);
            const value = attribute.getValue();
            if (!value) {
                return;
            }
            const result = analyzePhone(value, country);
            if (result.valid && result.display !== value) {
                attribute.setValue(result.display);
                attribute.setSubmitMode("never");
            }
        });
    }

    function analyzePhone(value, defaultCountry) {
        let text = value.trim();
        if (text.startsWith("00")) {
            text = "+" + text.substring(2).trim();
        }
        if (text.replace(/\D/g, "").length < MIN_DIGITS) {
            return { valid: false };
        }
        const lib = getLibrary();
        if (!lib) {
            return { valid: true, stored: value, display: value };
        }
        const phone = parsePhone(lib, text, defaultCountry);
        if (!phone || !(STRICT_VALIDATION ? phone.isValid() : phone.isPossible())) {
            return { valid: false };
        }
        const extension = phone.ext ? " x" + phone.ext : "";
        return {
            valid: true,
            stored: phone.number + extension,
            display: formatForDisplay(lib, phone) + extension
        };
    }

    function parsePhone(lib, text, defaultCountry) {
        if (text.startsWith("+")) {
            return lib.parsePhoneNumberFromString(text) || null;
        }
        const mainDigits = text.split(/[a-z]/i)[0].replace(/\D/g, "");
        if (NANP_TOLL_FREE_REGEX.test(mainDigits)) {
            return lib.parsePhoneNumberFromString(text, "US") || null;
        }
        const national = defaultCountry ? lib.parsePhoneNumberFromString(text, defaultCountry) : undefined;
        if (national && national.isValid()) {
            return national;
        }
        const international = lib.parsePhoneNumberFromString("+" + text);
        if (international && international.isValid()) {
            return international;
        }
        return national || null;
    }

    function formatForDisplay(lib, phone) {
        const national = phone.nationalNumber;
        if (phone.countryCallingCode === "1" && national.length === 10) {
            return "+1 (" + national.substring(0, 3) + ") " + national.substring(3, 6) + "-" + national.substring(6);
        }
        return lib.parsePhoneNumberFromString(phone.number).formatInternational();
    }

    function getDefaultCountry(formContext) {
        const option = formContext.getAttribute(COUNTRY_FIELD);
        if (option && option.getValue() !== null) {
            return COUNTRY_OPTION_CODES[option.getValue()] || null;
        }
        const lib = getLibrary();
        const legacy = formContext.getAttribute(LEGACY_COUNTRY_FIELD);
        if (!lib || !legacy || !legacy.getValue()) {
            return null;
        }
        return getCountryLookup(lib)[normalizeCountryKey(legacy.getValue())] || null;
    }

    function getCountryLookup(lib) {
        if (countryLookup) {
            return countryLookup;
        }
        const lookup = {};
        let displayNames = null;
        try {
            displayNames = new Intl.DisplayNames(["en"], { type: "region" });
        } catch (error) {
            displayNames = null;
        }
        lib.getCountries().forEach(function (code) {
            lookup[code.toLowerCase()] = code;
            const name = displayNames ? displayNames.of(code) : null;
            if (name) {
                lookup[normalizeCountryKey(name)] = code;
            }
        });
        Object.keys(COUNTRY_ALIASES).forEach(function (alias) {
            lookup[alias] = COUNTRY_ALIASES[alias];
        });
        countryLookup = lookup;
        return countryLookup;
    }

    function normalizeCountryKey(text) {
        return String(text)
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .toLowerCase()
            .replace(/\./g, "")
            .replace(/[^a-z]+/g, " ")
            .trim();
    }

    function getLibrary() {
        return typeof libphonenumber !== "undefined" ? libphonenumber : null;
    }

    function isEditable(attribute) {
        return attribute.controls.get().some(function (control) {
            return control.getVisible() && !control.getDisabled();
        });
    }

    function setFieldError(attribute) {
        attribute.controls.forEach(function (control) {
            control.setNotification(ERROR_MESSAGE, ERROR_ID);
        });
    }

    function clearFieldError(attribute) {
        attribute.controls.forEach(function (control) {
            control.clearNotification(ERROR_ID);
        });
    }

    function logError(handler, error) {
        console.error(LOG_PREFIX + handler + " failed.", error);
    }

    return {
        onLoad: onLoad,
        onPhoneChange: onPhoneChange,
        onCountryChange: onCountryChange,
        onSave: onSave
    };
})();
