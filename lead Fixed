// Common Alert Function

function DisplayAlertMessage(customTitle, customMessage) {
    "use strict";
    try {
        var alertStrings = {
            confirmButtonLabel: "OK",
            title: customTitle,
            text: customMessage,
        };
        var alertOptions = {
            height: 120,
            width: 260
        };
        Xrm.Navigation.openAlertDialog(alertStrings, alertOptions).then(function (success) { }, function (error) { });
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('DisplayAlertMessage Error: ' + (error.description || error.message));
    }
}
// Check if Form is Dirty if Yes return True else false

function CheckFormIsDirty() {
    "use strict";
    try {
        var isDirty = false;
        if (formContext.data.entity.getIsDirty()) {
            isDirty = true;
        }
        return isDirty;
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function CheckFormIsDirty" + (error.description || error.message));
    }
}
