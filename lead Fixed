//Function to Show Hide Tabs,Sections and Grids based on option set value for Lead Type

function ShowHideTabsSectionsBasedOnLeadType(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_leadtype").getValue() !== null && formContext.getAttribute("kofc_leadtype").getValue() !== undefined) {
            var leadType = formContext.getAttribute("kofc_leadtype").getValue();
            var sectionInstitutionalTeam = formContext.ui.tabs.get(tabsSectionsandGrids.TabTeamAndStakeholders).sections.get(tabsSectionsandGrids.SectionInstitutionalInvestmentTeam);
            var sectionSalesTeam = formContext.ui.tabs.get(tabsSectionsandGrids.TabTeamAndStakeholders).sections.get(tabsSectionsandGrids.SectionSalesTeam);
            if (leadType === optionSetValues.Insurance) //Lead Type - Insurance optionset value - 258510000
            {
                sectionInstitutionalTeam.setVisible(false);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.Fraternal) //Lead Type - Fraternal optionset value - 258510001
            {
                sectionInstitutionalTeam.setVisible(false);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.Charity) //Lead Type - Charity optionset value - 258510002
            {
                sectionInstitutionalTeam.setVisible(false);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.RetailInvestment) //Lead Type - RetailInvestment optionset value - 258510003
            {
                sectionInstitutionalTeam.setVisible(false);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.InstitutionalInvestment) //Lead Type - InstitutionalInvestment optionset value - 258510004
            {
                sectionInstitutionalTeam.setVisible(true);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("required");
                sectionSalesTeam.setVisible(false);
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.KCCF) //Lead Type - KCCF optionset value - 258510005
            {
                sectionInstitutionalTeam.setVisible(false);
                formContext.getControl("budgetamount").setVisible(true);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                HideTabsOnLead(executionContext);
            }
            else if (leadType === optionSetValues.Recruiting) { // Lead Type - Recruiting OptonSet Value = 258510006
                HideTabsOnLead(executionContext);
                formContext.getControl("budgetamount").setVisible(false);
                formContext.getAttribute("parentaccountid").setRequiredLevel("none");
                // if (formContext.getAttribute("kofc_leadsubtype").getValue() !== null && formContext.getAttribute("kofc_leadsubtype").getValue() !== undefined) {
                //     var leadSubType = formContext.getAttribute("kofc_leadsubtype").getValue()[0].name;
                //     if (leadSubType === "FA") {
                formContext.ui.tabs.get(tabsSectionsandGrids.TabRecruitingDetails).setVisible(true);
                //     }
                // }
            }
        }
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function ShowHideTabsSectionsBasedOnLeadType(Lead.js)" + (error.description || error.message));
    }
}
