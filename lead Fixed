        formCtx.getAttribute("emailaddress1").setRequiredLevel("required");
    }
    else if (!email && mobile) {
        formCtx.getAttribute("emailaddress1").setRequiredLevel("none");
        formCtx.getAttribute("mobilephone").setRequiredLevel("required");
    }
    else if (email && mobile) {
        formCtx.getAttribute("emailaddress1").setRequiredLevel("none");
        formCtx.getAttribute("mobilephone").setRequiredLevel("none");
    }
    else {
        formCtx.getAttribute("emailaddress1").setRequiredLevel("required");
        formCtx.getAttribute("mobilephone").setRequiredLevel("required");
    }
}
