//On SaveRecord
function OnSave(executionContext) {
    "use strict";
    try {
        formContext = executionContext.getFormContext();
        var formType = formContext.ui.getFormType();
        if (formType === 1) {
            var email = formContext.getAttribute("emailaddress1").getValue();
            var homePhone = formContext.getAttribute("telephone2").getValue();
            var businessPhone = formContext.getAttribute("telephone1").getValue();
            var mobilePhone = formContext.getAttribute("mobilephone").getValue();
            if (email !== null || (homePhone !== null || businessPhone !== null || mobilePhone !== null)) {
                formContext.ui.clearFormNotification("field-check");
            }
            else {
                formContext.ui.setFormNotification("Please fill out either email or any of three phone numbers.", "ERROR", "field-check");
                executionContext.getEventArgs().preventDefault();
            }
        }
        updateContact(executionContext);
    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function OnSave" + (error.description || error.message));
    }
}
