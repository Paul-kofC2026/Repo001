function OnLoad(executionContext) {
    "use strict";
    try {
        formContext = executionContext.getFormContext();
        GetLoggedInUserTeamSecurityRole(formContext);
        var leadType = formContext.getAttribute('kofc_leadtype').getValue();
        //formContext.getAttribute("parentcontactid").setRequiredLevel("required");
        formContext.getControl("budgetamount").setVisible(false);
        ShowHideTabsSectionsBasedOnLeadType(executionContext);
        //OnChangeContactUpdateFNameLNameKccfRegion(executionContext);
        var formType = formContext.ui.getFormType();
        if (formType !== 1) {
            SetBPFStageBasedonLeadType(executionContext);
            if (formContext.getAttribute("kofc_leadtype").getValue() !== null) {
                formContext.getControl("kofc_leadtype").setDisabled(true);
            }
            formContext.data.refresh();
        }
        else {
            formContext.getControl("kofc_gendercode").setDisabled(false);
            formContext.getControl("kofc_dateofbirth").setDisabled(false);
        }
        FilterLeadSubType(executionContext);
        if (formType !== 1 && leadType !== null && leadType === optionSetValues.Fraternal && formContext.getControl("header_process_kofc_leadsubtype")) {
            formContext.getControl("header_process_kofc_leadsubtype").setVisible(false);
        }
        // Added below code as part of US: 3388
        ShowHideContactQuickViewfields(executionContext);
        initializeContactFields(executionContext);
        // End 3388
        //CheckField(formContext);
        //Added below function to onLoad. US #27930
        LockGenderAndDOBFields(executionContext);
        showHideAgencypromocode(executionContext);
        setContactValidation(executionContext);
        ShowHideAgentPromoCode(executionContext);

    }
    catch (error) {
        DisplayAlertMessage("ERROR", "Error At function OnLoad" + (error.description || error.message));
    }
}

function CheckField(formContext) {
    "use strict";
    var attributes = formContext.data.entity.attributes.get();
    for (var i in attributes) {
        var attribute = attributes[i];
        if (attribute.getIsDirty()) Xrm.Navigation.openAlertDialog({ text: "attribute dirty: " + attribute.getName() });
        //console.log("attribute dirty: " + attribute.getName());
    }
}

