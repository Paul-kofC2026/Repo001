//Funtion to Open to Quick Lead form On click New Lead Button
function CreateQuickCreateLead(selectedControl) {
    "use strict";
    try {
        //Get the SubGrid Control
        var viewSelector = selectedControl.getViewSelector();
        if (viewSelector !== null && viewSelector !== undefined) {
            var currentViewName = selectedControl.getViewSelector().getCurrentView().name;
            if (currentViewName === "Recruiting Leads") {
                var entityFormOptions = {};
                entityFormOptions["entityName"] = "lead";
                entityFormOptions["useQuickCreateForm"] = true;
                var formParameters = {};
                formParameters["kofc_leadtype"] = optionSetValues.Recruiting;
                Xrm.Navigation.openForm(entityFormOptions, formParameters).then(function (success) { }, function (error) { })
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('CreateQuickCreateLead Error: ' + (error.description || error.message));
    }
}

//Function to Set Lead Type Disabled for recruiting.
function MakeLeadTypeDisabled(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_leadtype").getValue() !== null && formContext.getAttribute("kofc_leadtype").getValue() !== undefined) {
            var leadType = formContext.getAttribute("kofc_leadtype").getValue();
            if (leadType === optionSetValues.Recruiting) {
