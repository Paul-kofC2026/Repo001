function OnChangePhoneNumber(executionContext, attributeSchema) {
    "use strict";
    try {

        var formContext = executionContext.getFormContext();
        var phoneNumberPattern = /^\(\d{3}\) \d{3}-\d{4}$/;
        var phone = formContext.getAttribute(attributeSchema).getValue(); //get Phone value
        formContext.getControl(attributeSchema).clearNotification("PhoneError");
        if (phone !== null && !phoneNumberPattern.test(phone)) {
            if (phone !== null && (phone.length < 10 || phone.length > 10 || isNaN(phone))) {
                var tenDigitNumericValueKeyMessage = Xrm.Utility.getResourceString(Messages.Resource, Messages.TenDigitNumericValueKey);
                formContext.getControl(attributeSchema).setNotification(tenDigitNumericValueKeyMessage, "PhoneError");
            }
            else {
                formContext.getControl(attributeSchema).clearNotification("PhoneError");
                formContext.getAttribute(attributeSchema).setValue("(" + phone.substr(0, 3) + ") " + phone.substr(3, 3) + "-" + phone.substr(6, phone.length));
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog("Error At function OnChangePhoneNumber" + (error.description || error.message));
    }
}

function setLeadTypeForOnPageLoadForRoles(executionContext) {
    var formContext = executionContext.getFormContext();
    if (formContext !== "undefined" && formContext !== null) {

        var userRoles = Xrm.Utility.getGlobalContext().userSettings.roles;

        if (userRoles !== null && userRoles !== undefined) {
            userRoles.forEach(function (item) {
                if (item.name.toLowerCase() === "insurance leader" || item.name.toLowerCase() === "insurance sales" || item.name.toLowerCase() === "agency support") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Insurance);
                    return;
                }
                else if (item.name.toLowerCase() === "fraternal manager") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Fraternal);
                    return;
                }
                else if (item.name.toLowerCase() === "charity leader" || item.name.toLowerCase() === "charity user") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.Charity);
                    return;
                }//changed 2.0
                else if (item.name.toLowerCase() === "investment manager" || item.name.toLowerCase() === "investment support" || item.name.toLowerCase() == "investment leader​​") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.InstitutionalInvestment);
                    return;
                }
                else if (item.name.toLowerCase() === "retail investment sales") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.RetailInvestment);
                    return;
                }
                else if (item.name.toLowerCase() === "kccf leader" || item.name.toLowerCase() === "kccf user") {
                    formContext.getControl('kofc_leadtype').getAttribute().setValue(optionSetValues.KCCF);
                    return;
                }

            });
        }
    }
}
