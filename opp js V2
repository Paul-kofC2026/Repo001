    // ============================================================
    // PUBLIC ENTRY POINT - OPPORTUNITY FORM ONLOAD
    // ============================================================

    function onLoad(executionContext) {
        const formContext = getFormContext(executionContext);
        if (!formContext) {
            return;
        }

        log("Initializing Opportunity BPF Stage Gate.");

        STATE.formContext = formContext;
        registerGuidanceMessageHandler();
        registerFieldHandlers(formContext);
        registerSubgridHandlers(formContext);
        registerBpfHandlers(formContext);
        registerPostSaveHandler(formContext);
        validateConfigurationOnLoad(formContext);
        updateStageGateGuidance(formContext);

        STATE.initialized = true;
        log("Initialization complete.");
    }

    // ============================================================
    // EVENT REGISTRATION
    // ============================================================

    function registerFieldHandlers(formContext) {
        if (STATE.fieldHandlersRegistered) {
            return;
        }

        const logicalNames = getConfiguredStageFieldNames();

        logicalNames.forEach(function (logicalName) {
            if (isPlaceholder(logicalName)) {
                return;
            }

            const attribute = formContext.getAttribute(logicalName);
            if (!attribute) {
                warn("Configured stage-gate field is not available on the form: " + logicalName);
                return;
            }

            // Avoid duplicate handlers on repeated initialization.
            try {
                attribute.removeOnChange(onFieldChange);
            } catch (e) {
                // no-op
            }

            attribute.addOnChange(onFieldChange);
        });

        STATE.fieldHandlersRegistered = true;
    }

    function registerPostSaveHandler(formContext) {
        if (STATE.postSaveHandlerRegistered) {
            return;
        }

        const entity = formContext.data && formContext.data.entity;
        if (!entity || typeof entity.addOnPostSave !== "function") {
            warn("PostSave API is not available on the Opportunity form.");
            return;
        }

        try {
            if (typeof entity.removeOnPostSave === "function") {
                entity.removeOnPostSave(onPostSave);
            }
        } catch (e) {
            // no-op
        }

        entity.addOnPostSave(onPostSave);
        STATE.postSaveHandlerRegistered = true;
        log("PostSave handler registered.");
    }

    function registerBpfHandlers(formContext) {
        if (STATE.bpfHandlersRegistered) {
            return;
        }

        const process = formContext.data && formContext.data.process;

        if (!process || typeof process.addOnPreStageChange !== "function") {
            retryBpfRegistration(formContext);
            return;
        }

        try {
            process.removeOnPreStageChange(onPreStageChange);
        } catch (e) {
            // no-op
        }

        try {
            process.removeOnStageChange(onStageChange);
        } catch (e) {
            // no-op
        }

        process.addOnPreStageChange(onPreStageChange);
        process.addOnStageChange(onStageChange);

        STATE.bpfHandlersRegistered = true;
        log("BPF event handlers registered.");

        // Evaluate the current stage once after the BPF is ready.
        scheduleInitialEvaluation(formContext);
    }

    function scheduleInitialEvaluation(formContext) {
        if (STATE.initialEvaluationScheduled) {
            return;
        }

        STATE.initialEvaluationScheduled = true;

        const tryInitialEvaluation = function () {
            const process = formContext.data && formContext.data.process;
            const activeStage = process && typeof process.getActiveStage === "function"
                ? process.getActiveStage()
                : null;

            if (!activeStage) {
                STATE.initialEvaluationAttempts += 1;

                if (STATE.initialEvaluationAttempts < 10) {
                    window.setTimeout(tryInitialEvaluation, 500);
                } else {
                    warn("Initial stage evaluation was skipped because the active BPF stage was not available.");
                }

                return;
            }

            // Refresh legacy-compatible guidance once the BPF stage is available.
            updateStageGateGuidance(formContext);

            // Skip initial evaluation until the Opportunity has been saved.
            if (!getOpportunityId(formContext)) {
                log("Initial stage evaluation skipped for an unsaved Opportunity.");
                return;
            }

            evaluateCurrentStage(formContext, {
                source: "load",
                autoAdvance: true,
                showMissing: false
            });
        };

        window.setTimeout(tryInitialEvaluation, 250);
    }

    function retryBpfRegistration(formContext) {
        if (STATE.bpfRegistrationAttempts >= 10) {
            setFormNotification(
                formContext,
                "The Opportunity BPF could not be initialized. Refresh the form or contact an administrator.",
                "ERROR",
                CONFIG.notifications.runtime
            );
            return;
        }

        STATE.bpfRegistrationAttempts += 1;

        window.setTimeout(function () {
            registerBpfHandlers(formContext);
        }, 500);
    }

    function registerSubgridHandlers(formContext) {
        if (STATE.subgridHandlersRegistered || !formContext.ui || !formContext.ui.controls) {
            return;
        }

        formContext.ui.controls.forEach(function (control) {
            try {
                if (!control || typeof control.getControlType !== "function") {
                    return;
                }

                if (control.getControlType() !== "subgrid") {
                    return;
                }

                if (typeof control.getEntityName !== "function") {
                    return;
                }

                const entityName = control.getEntityName();
                if (!entityName || CONFIG.relatedGridEntities.indexOf(entityName) === -1) {
                    return;
                }

                if (typeof control.addOnLoad !== "function") {
                    return;
                }

                const handler = function () {
                    onRelatedSubgridLoad(formContext, control);
                };

                control.addOnLoad(handler);

                // Capture the current grid state as the baseline.
                try {
                    if (typeof control.getGrid === "function" && control.getGrid()) {
                        markSubgridBaseline(formContext, control);
                    }
                } catch (gridError) {
                    // The first grid OnLoad will establish the baseline.
                }

                log("Registered related subgrid handler: " + control.getName() + " (" + entityName + ")");
            } catch (e) {
                warn("Unable to register a subgrid handler: " + getErrorMessage(e));
            }
        });

        STATE.subgridHandlersRegistered = true;
    }

    // ============================================================
    // FORM / SUBGRID EVENTS
    // ============================================================

    function onPostSave(executionContext) {
        const formContext = getFormContext(executionContext);
        const eventArgs = executionContext && executionContext.getEventArgs
            ? executionContext.getEventArgs()
            : null;

        if (!formContext) {
            return;
        }

        if (
            eventArgs &&
            typeof eventArgs.getIsSaveSuccess === "function" &&
            !eventArgs.getIsSaveSuccess()
        ) {
            return;
        }

        clearTransientNotifications(formContext);
        updateStageGateGuidance(formContext);

        evaluateCurrentStage(formContext, {
            source: "save",
            autoAdvance: true,
            showMissing: true
        });
    }

    function onFieldChange(executionContext) {
        const formContext = getFormContext(executionContext);
        if (!formContext) {
            return;
        }

        clearTransientNotifications(formContext);
        updateStageGateGuidance(formContext);

        evaluateCurrentStage(formContext, {
            source: "field",
            autoAdvance: true,
            showMissing: false
        });
    }

    function onRelatedSubgridLoad(formContext, control) {
        if (!formContext || !control) {
            return;
        }

        const key = getSubgridBaselineKey(formContext, control);

        // Treat the first load as baseline; later refreshes trigger evaluation.
        if (!STATE.subgridBaseline[key]) {
            STATE.subgridBaseline[key] = true;
            log("Subgrid baseline captured: " + key);
            return;
        }

        clearTransientNotifications(formContext);

        evaluateCurrentStage(formContext, {
            source: "subgrid",
            autoAdvance: true,
            showMissing: false
        });
    }

    function onStageChange(executionContext) {
        const formContext = getFormContext(executionContext);
        if (!formContext) {
            return;
        }

        clearTransientNotifications(formContext);
        updateStageGateGuidance(formContext);

        // Refresh the banner against the new stage without auto-advancing it.
        refreshStageGateGuidance(formContext);

        // Do not run the normal auto-advance controller on the new stage here;
        // stage moves remain one-at-a-time.
        window.setTimeout(function () {
            primeSubgridBaselinesForCurrentStage(formContext);
        }, 0);
    }

    // ============================================================
    // STAGE REQUIREMENT GUIDANCE / VISIBILITY
    // ============================================================

    function updateStageGateGuidance(formContext, validation) {
        if (!formContext) {
            return;
        }

        try {
            const activeStage = getActiveStage(formContext);
            if (!activeStage) {
                return;
            }

            const currentStageName = safeStageName(activeStage);
            const stageKey = getStageKey(currentStageName);
            const stageConfig = CONFIG.stageConfiguration[stageKey];
            const typeKey = getOpportunityTypeConfigKey(getOpportunityType(formContext));

            if (!stageConfig || !typeKey) {
                setStageGateInfoSectionVisible(formContext, false);
                setStageGateBannerControlVisible(formContext, false);
                return;
            }

            const visible = getStageTypeSetting(
                stageConfig.infoSectionVisible,
                typeKey,
                false
            ) === true;

            const bannerAvailable = !!getStageGateBannerControl(formContext);

            setStageGateInfoSectionVisible(formContext, visible);
            setStageGateBannerControlVisible(formContext, visible && bannerAvailable);
            setLegacyGuidancePlaceholderControlVisible(
                formContext,
                visible && !bannerAvailable
            );

            if (!visible) {
                return;
            }

            // Preserve the existing placeholder-field guidance as a fallback.
            updateLegacyGuidancePlaceholder(formContext, stageConfig, typeKey);

            // Ignore stale validation results if the BPF stage moved while validation was running.
            const usableValidation = validation &&
                normalizeText(validation.stageName) === normalizeText(currentStageName)
                ? validation
                : null;

            if (usableValidation) {
                renderStageGateBanner(formContext, usableValidation, stageKey, typeKey);
            } else {
                renderStageGateBannerLoading(formContext, currentStageName, typeKey);
            }
        } catch (error) {
            warn("Unable to update stage-gate guidance: " + getErrorMessage(error));
        }
    }

    function updateLegacyGuidancePlaceholder(formContext, stageConfig, typeKey) {
        const guidanceAttribute = formContext.getAttribute(
            CONFIG.ui.stageGateInfoFieldLogicalName
        );

        if (!guidanceAttribute) {
            return;
        }

        const guidanceHtml = getStageTypeSetting(
            stageConfig.guidanceHtml,
            typeKey,
            null
        );

        const nextStageName = getNextActivePathStageName(formContext) || "the next";
        const message = guidanceHtml
            ? '<span style="font-size:15px;">Required items to move to <strong>' +
                nextStageName + "</strong> Stage: " + guidanceHtml + ".</span>"
            : "";

        guidanceAttribute.setValue(message);

        if (typeof guidanceAttribute.setSubmitMode === "function") {
            guidanceAttribute.setSubmitMode("never");
        }
    }

    function setLegacyGuidancePlaceholderControlVisible(formContext, visible) {
        if (!formContext) {
            return;
        }

        const attribute = formContext.getAttribute(
            CONFIG.ui.stageGateInfoFieldLogicalName
        );

        if (!attribute || !attribute.controls || typeof attribute.controls.forEach !== "function") {
            return;
        }

        attribute.controls.forEach(function (control) {
            try {
                if (control && typeof control.setVisible === "function") {
                    control.setVisible(visible === true);
                }
            } catch (error) {
                warn("Unable to update legacy guidance control visibility: " + getErrorMessage(error));
            }
        });
    }

    async function refreshStageGateGuidance(formContext) {
        if (!formContext) {
            return;
        }

        try {
            const activeStage = getActiveStage(formContext);
            if (!activeStage) {
                return;
            }

            const stageKey = getStageKey(safeStageName(activeStage));
            const stageConfig = CONFIG.stageConfiguration[stageKey];
            const typeKey = getOpportunityTypeConfigKey(getOpportunityType(formContext));

            if (!stageConfig || !typeKey) {
                updateStageGateGuidance(formContext);
                return;
            }

            const visible = getStageTypeSetting(
                stageConfig.infoSectionVisible,
                typeKey,
                false
            ) === true;

            if (!visible) {
                updateStageGateGuidance(formContext);
                return;
            }

            const validation = await validateCurrentStage(formContext);
            updateStageGateGuidance(formContext, validation);
        } catch (error) {
            warn("Unable to refresh stage-gate guidance: " + getErrorMessage(error));
        }
    }

    function renderStageGateBannerLoading(formContext, stageName, typeKey) {
        const data = {
            loading: true,
            stage: stageName,
            nextStage: getNextActivePathStageName(formContext) || "the next stage",
            opportunityType: typeKey === "strategic" ? "Strategic" : "Transactional",
            requirements: []
        };

        sendStageGateBannerData(formContext, data);
    }

    function renderStageGateBanner(formContext, validation, stageKey, typeKey) {
        const data = buildStageGateBannerData(
            formContext,
            validation,
            stageKey,
            typeKey
        );

        sendStageGateBannerData(formContext, data);
    }

    function buildStageGateBannerData(formContext, validation, stageKey, typeKey) {
        const configured = getStageTypeSetting(
            CONFIG.guidance.requirements[stageKey],
            typeKey,
            []
        ) || [];

        const missing = Array.isArray(validation.missing)
            ? validation.missing.slice(0)
            : [];

        const matchedMissing = Object.create(null);

        const requirements = configured.map(function (definition) {
            const matches = Array.isArray(definition.matches) && definition.matches.length > 0
                ? definition.matches
                : [definition.label];

            let isMissing = false;

            matches.forEach(function (candidate) {
                if (missing.indexOf(candidate) !== -1) {
                    isMissing = true;
                    matchedMissing[candidate] = true;
                }
            });

            return {
                key: definition.key,
                label: definition.label,
                complete: !isMissing,
                navigable: !!definition.navigation
            };
        });

        // Keep validation authoritative. Any missing item not represented in the
        // banner metadata is still surfaced rather than being silently omitted.
        missing.forEach(function (item, index) {
            if (!matchedMissing[item]) {
                requirements.push({
                    key: "unmapped_" + index,
                    label: item,
                    complete: false,
                    navigable: false
                });
            }
        });

        return {
            loading: false,
            stage: validation.stageName,
            nextStage: getNextActivePathStageName(formContext) || "the next stage",
            opportunityType: typeKey === "strategic" ? "Strategic" : "Transactional",
            requirements: requirements
        };
    }

    function sendStageGateBannerData(formContext, data) {
        const control = getStageGateBannerControl(formContext);
        if (!control || typeof control.getContentWindow !== "function") {
            return false;
        }

        try {
            const contentWindowResult = control.getContentWindow();

            Promise.resolve(contentWindowResult)
                .then(function (bannerWindow) {
                    if (!bannerWindow) {
                        return;
                    }

                    try {
                        if (
                            bannerWindow.StageGateBanner &&
                            typeof bannerWindow.StageGateBanner.setData === "function"
                        ) {
                            bannerWindow.StageGateBanner.setData(data);
                            return;
                        }
                    } catch (directError) {
                        // Fall through to postMessage for iframe isolation scenarios.
                    }

                    if (typeof bannerWindow.postMessage === "function") {
                        bannerWindow.postMessage(
                            {
                                type: "CHR_STAGE_GATE_BANNER",
                                action: "setData",
                                data: data
                            },
                            "*"
                        );
                    }
                })
                .catch(function (error) {
                    warn("Unable to access the stage-gate guidance web resource: " + getErrorMessage(error));
                });

            return true;
        } catch (error) {
            warn("Unable to update the stage-gate guidance web resource: " + getErrorMessage(error));
            return false;
        }
    }

    function setStageGateBannerControlVisible(formContext, visible) {
        const control = getStageGateBannerControl(formContext);
        if (!control || typeof control.setVisible !== "function") {
            return;
        }

        try {
            control.setVisible(visible === true);
        } catch (error) {
            warn("Unable to update stage-gate banner visibility: " + getErrorMessage(error));
        }
    }

    function getStageGateBannerControl(formContext) {
        if (!formContext) {
            return null;
        }

        if (typeof formContext.getControl === "function") {
            const configuredControl = formContext.getControl(
                CONFIG.ui.stageGateBannerControlName
            );

            if (configuredControl) {
                return configuredControl;
            }
        }

        const controls = formContext.ui && formContext.ui.controls;
        if (!controls || typeof controls.forEach !== "function") {
            return null;
        }

        let match = null;
        const resourceToken = normalizeText(CONFIG.ui.stageGateBannerResourceName);
        const nameToken = normalizeText(CONFIG.ui.stageGateBannerControlName)
            .replace("webresource_", "");

        controls.forEach(function (control) {
            if (match || !control) {
                return;
            }

            try {
                const controlType = typeof control.getControlType === "function"
                    ? normalizeText(control.getControlType())
                    : "";

                if (controlType !== "webresource") {
                    return;
                }

                const controlName = typeof control.getName === "function"
                    ? normalizeText(control.getName())
                    : "";

                const src = typeof control.getSrc === "function"
                    ? normalizeText(control.getSrc())
                    : "";

                if (
                    (nameToken && controlName.indexOf(nameToken) !== -1) ||
                    (resourceToken && src.indexOf(resourceToken) !== -1)
                ) {
                    match = control;
                }
            } catch (error) {
                // Ignore unrelated controls that do not expose web-resource APIs.
            }
        });

        return match;
    }

    function registerGuidanceMessageHandler() {
        if (STATE.guidanceMessageHandlerRegistered || !window.addEventListener) {
            return;
        }

        window.addEventListener("message", onGuidanceBannerMessage, false);
        STATE.guidanceMessageHandlerRegistered = true;
    }

    function onGuidanceBannerMessage(event) {
        const message = event && event.data;
        if (!message || message.type !== CONFIG.guidance.messageType) {
            return;
        }

        if (message.action !== "navigate" || !message.requirementKey) {
            return;
        }

        navigateToGuidanceRequirement(message.requirementKey);
    }

    function navigateToGuidanceRequirement(requirementKey) {
        const formContext = STATE.formContext;
        if (!formContext || !requirementKey) {
            return false;
        }

        const definition = findGuidanceRequirementDefinition(
            formContext,
            requirementKey
        );

        if (!definition || !definition.navigation) {
            setFormNotification(
                formContext,
                "This requirement does not have a configured form navigation target.",
                "INFO",
                CONFIG.notifications.guidance
            );
            return false;
        }

        clearFormNotification(formContext, CONFIG.notifications.guidance);

        const navigation = definition.navigation;
        let control = null;

        if (navigation.type === "field") {
            control = getFirstFieldControl(formContext, navigation.logicalName);
        } else if (navigation.type === "subgridEntity") {
            control = findSubgridByEntityName(formContext, navigation.entityLogicalName);
        }

        if (!control) {
            setFormNotification(
                formContext,
                "The form location for " + definition.label + " could not be found.",
                "INFO",
                CONFIG.notifications.guidance
            );
            return false;
        }

        revealControlContainer(control);

        window.setTimeout(function () {
            try {
                if (typeof control.setFocus === "function") {
                    control.setFocus();
                }
            } catch (error) {
                warn("Unable to focus guidance target: " + getErrorMessage(error));
            }
        }, 100);

        return true;
    }

    function findGuidanceRequirementDefinition(formContext, requirementKey) {
        const activeStage = getActiveStage(formContext);
        if (!activeStage) {
            return null;
        }

        const stageKey = getStageKey(safeStageName(activeStage));
        const typeKey = getOpportunityTypeConfigKey(getOpportunityType(formContext));
        const definitions = getStageTypeSetting(
            CONFIG.guidance.requirements[stageKey],
            typeKey,
            []
        ) || [];

        return definitions.find(function (definition) {
            return definition && definition.key === requirementKey;
        }) || null;
    }

    function getFirstFieldControl(formContext, logicalName) {
        if (!formContext || !logicalName) {
            return null;
        }

        const attribute = formContext.getAttribute(logicalName);
        if (
            attribute &&
            attribute.controls &&
            typeof attribute.controls.get === "function"
        ) {
            const control = attribute.controls.get(0);
            if (control) {
                return control;
            }
        }

        return typeof formContext.getControl === "function"
            ? formContext.getControl(logicalName)
            : null;
    }

    function findSubgridByEntityName(formContext, entityLogicalName) {
        const controls = formContext && formContext.ui && formContext.ui.controls;
        if (!controls || typeof controls.forEach !== "function") {
            return null;
        }

        let match = null;
        const expected = normalizeText(entityLogicalName);

        controls.forEach(function (control) {
            if (match || !control) {
                return;
            }

            try {
                if (
                    typeof control.getControlType !== "function" ||
                    normalizeText(control.getControlType()) !== "subgrid" ||
                    typeof control.getEntityName !== "function"
                ) {
                    return;
                }

                if (normalizeText(control.getEntityName()) === expected) {
                    match = control;
                }
            } catch (error) {
                // no-op
            }
        });

        return match;
    }

    function revealControlContainer(control) {
        if (!control || typeof control.getParent !== "function") {
            return;
        }

        try {
            const section = control.getParent();
            const tab = section && typeof section.getParent === "function"
                ? section.getParent()
                : null;

            if (tab) {
                if (typeof tab.setVisible === "function") {
                    tab.setVisible(true);
                }

                if (typeof tab.setDisplayState === "function") {
                    tab.setDisplayState("expanded");
                }

                if (typeof tab.setFocus === "function") {
                    tab.setFocus();
                }
            }

            if (section && typeof section.setVisible === "function") {
                section.setVisible(true);
            }
        } catch (error) {
            warn("Unable to reveal guidance target container: " + getErrorMessage(error));
        }
    }

    function setStageGateInfoSectionVisible(formContext, visible) {
        try {
            if (
                !formContext ||
                !formContext.ui ||
                !formContext.ui.tabs ||
                typeof formContext.ui.tabs.get !== "function"
            ) {
                return;
            }

            const tab = formContext.ui.tabs.get(CONFIG.ui.summaryTabName);
            if (!tab || !tab.sections || typeof tab.sections.get !== "function") {
                return;
            }

            const section = tab.sections.get(CONFIG.ui.stageGateInfoSectionName);
            if (!section || typeof section.setVisible !== "function") {
                return;
            }

            section.setVisible(visible === true);
        } catch (error) {
            warn("Unable to update stage-gate information section visibility: " + getErrorMessage(error));
        }
    }

    function getNextActivePathStageName(formContext) {
        try {
            const process = formContext && formContext.data && formContext.data.process;
            if (
                !process ||
                typeof process.getActiveStage !== "function" ||
                typeof process.getActivePath !== "function"
            ) {
                return "";
            }

            const activeStage = process.getActiveStage();
            const activePath = process.getActivePath();
            const stages = activePath && typeof activePath.getAll === "function"
                ? activePath.getAll()
                : [];

            if (!activeStage || !Array.isArray(stages) || stages.length === 0) {
                return "";
            }

            const activeStageId = normalizeGuid(activeStage.getId());
            const activeIndex = stages.findIndex(function (stage) {
                return stage && normalizeGuid(stage.getId()) === activeStageId;
            });

            if (activeIndex < 0 || activeIndex + 1 >= stages.length) {
                return "";
            }

            return safeStageName(stages[activeIndex + 1]);
        } catch (error) {
            warn("Unable to determine the next BPF stage for guidance: " + getErrorMessage(error));
            return "";
        }
    }

    // ============================================================
    // MANUAL NEXT / PREVIOUS STAGE CONTROL
    // ============================================================

    function onPreStageChange(executionContext) {
        const formContext = getFormContext(executionContext);
        const eventArgs = executionContext && executionContext.getEventArgs
            ? executionContext.getEventArgs()
            : null;

        if (!formContext || !eventArgs) {
            return;
        }

        // Allow the controller-initiated move through PreStageChange.
        if (STATE.bypassPreStageChangeOnce) {
            STATE.bypassPreStageChangeOnce = false;
            return;
        }

        const direction = normalizeText(
            typeof eventArgs.getDirection === "function"
                ? eventArgs.getDirection()
                : ""
        );

        if (direction === "previous") {
            if (CONFIG.blockBackwardNavigation) {
                eventArgs.preventDefault();
                showBackwardNavigationBlocked();
            }
            return;
        }

        if (direction !== "next") {
            return;
        }

        // Cancel first, then validate asynchronously.
        eventArgs.preventDefault();

        handleManualNext(formContext);
    }

    async function handleManualNext(formContext) {
        try {
            const validation = await validateCurrentStage(formContext);

            // Render guidance from the same validation result used for blocking and auto-advance.
            updateStageGateGuidance(formContext, validation);

            if (validation.terminal) {
                return;
            }

            if (validation.pathMismatch) {
                await showPathMismatch(validation);
                return;
            }

            if (!validation.isComplete) {
                await showMissingRequirements(validation);
                focusFirstMissingFormField(formContext, validation);
                return;
            }

            await advanceOneStage(formContext, "manual");
        } catch (error) {
            await handleRuntimeError(formContext, "Unable to validate the current BPF stage.", error, true);
        }
    }

    // ============================================================
    // AUTOMATIC EVALUATION
    // ============================================================

    async function evaluateCurrentStage(formContext, options) {
        options = options || {};

        if (STATE.evaluationRunning) {
            STATE.pendingEvaluation = true;
            return;
        }

        if (STATE.stageMoveRunning) {
            return;
        }

        if (options.autoAdvance && Date.now() < STATE.suppressAutoUntil) {
            return;
        }

        const startingStage = getActiveStage(formContext);
        const startingStageId = startingStage
            ? normalizeGuid(startingStage.getId())
            : "";

        let stageAdvanced = false;

        try {
            STATE.evaluationRunning = true;

            const validation = await validateCurrentStage(formContext);

            if (validation.terminal) {
                return;
            }

            if (validation.pathMismatch) {
                setFormNotification(
                    formContext,
                    validation.pathMessage,
                    "ERROR",
                    CONFIG.notifications.path
                );
                return;
            }

            if (validation.configurationErrors.length > 0) {
                setFormNotification(
                    formContext,
                    "Opportunity stage-gate configuration is incomplete. Contact a system administrator.",
                    "ERROR",
                    CONFIG.notifications.configuration
                );
            } else {
                clearFormNotification(formContext, CONFIG.notifications.configuration);
            }

            if (!validation.isComplete) {
                if (options.showMissing) {
                    await showMissingRequirements(validation);
                }
                return;
            }

            if (options.autoAdvance) {
                stageAdvanced = await advanceOneStage(
                    formContext,
                    options.source || "automatic"
                ) === true;
            }
        } catch (error) {
            await handleRuntimeError(formContext, "Automatic BPF stage validation failed.", error, false);
        } finally {
            STATE.evaluationRunning = false;

            if (STATE.pendingEvaluation) {
                STATE.pendingEvaluation = false;

                const currentStage = getActiveStage(formContext);
                const currentStageId = currentStage
                    ? normalizeGuid(currentStage.getId())
                    : "";

                // Replay once when a change arrived during validation and the stage did not move.
                if (
                    !stageAdvanced &&
                    startingStageId &&
                    currentStageId === startingStageId
                ) {
                    window.setTimeout(function () {
                        evaluateCurrentStage(formContext, {
                            source: "pending",
                            autoAdvance: true,
                            showMissing: false
                        });
                    }, 0);
                }
            }
        }
    }

    // ============================================================
    // CURRENT-STAGE DISPATCH
    // ============================================================

    async function validateCurrentStage(formContext) {
        const activeStage = getActiveStage(formContext);

        if (!activeStage) {
            throw new Error("No active Business Process Flow stage is available.");
        }

        const stageName = safeStageName(activeStage);
        const stageKey = getStageKey(stageName);
        const opportunityType = getOpportunityType(formContext);

        log("Validating stage: " + stageName + "; Opportunity Type: " + opportunityType);

        switch (stageKey) {
            case "salesProcess":
                return await validateSalesProcess(formContext, stageName);

            case "discovery":
                if (opportunityType !== CONFIG.opportunityType.strategic) {
                    return pathMismatchResult(
                        stageName,
                        "Discovery is only valid for Strategic opportunities."
                    );
                }
                return await validateDiscovery(formContext, stageName);

            case "solutionDesign":
                if (opportunityType !== CONFIG.opportunityType.strategic) {
                    return pathMismatchResult(
                        stageName,
                        "Solution Design & Pricing is only valid for Strategic opportunities."
                    );
                }
                return await validateSolutionDesign(formContext, stageName);

            case "propose":
                return await validatePropose(formContext, stageName);

            case "negotiate":
                if (opportunityType !== CONFIG.opportunityType.strategic) {
                    return pathMismatchResult(
                        stageName,
                        "Negotiate & Commit is only valid for Strategic opportunities."
                    );
                }
                return await validateNegotiate(formContext, stageName);

            case "implementation":
                return terminalResult(stageName);

            default:
                return pathMismatchResult(
                    stageName,
                    "The active BPF stage is not configured in the Opportunity stage-gate controller."
                );
        }
    }

    // ============================================================
    // STAGE VALIDATORS
    // ============================================================

    async function validateSalesProcess(formContext, stageName) {
        const result = newValidationResult(stageName);
        const value = getOpportunityType(formContext);

        if (!(await accountIsActive(formContext))) {
            result.missing.push("Account Status must be Active");
            markFirstMissingFormField(result, CONFIG.account.opportunityLookupLogicalName);
        }

        if (
            value !== CONFIG.opportunityType.strategic &&
            value !== CONFIG.opportunityType.transactional
        ) {
            result.missing.push(getFieldLabel(CONFIG.opportunityType.logicalName));
            markFirstMissingFormField(result, CONFIG.opportunityType.logicalName);
        }

        // Strategic Sales Process restores the legacy field requirements.
        validateConfiguredStageFields(formContext, "salesProcess", value, result);

        finalizeValidationResult(result);
        return result;
    }

    async function validateDiscovery(formContext, stageName) {
        const result = newValidationResult(stageName);

        if (!(await accountIsActive(formContext))) {
            result.missing.push("Account Status must be Active");
            markFirstMissingFormField(result, CONFIG.account.opportunityLookupLogicalName);
        }

        validateConfiguredStageFields(
            formContext,
            "discovery",
            getOpportunityType(formContext),
            result
        );

        const opportunityId = requireSavedOpportunity(formContext, result);

        if (opportunityId) {
            const productExists = await relatedRecordExists(
                CONFIG.related.opportunityProduct.entityLogicalName,
                CONFIG.related.opportunityProduct.opportunityLookupProperty + " eq " + opportunityId
            );

            if (!productExists) {
                result.missing.push("At least one Opportunity Product");
            }

            const cCodeExists = await relatedRecordExists(
                CONFIG.related.cCode.entityLogicalName,
                CONFIG.related.cCode.opportunityLookupProperty + " eq " + opportunityId
            );

            if (!cCodeExists) {
                result.missing.push("At least one C-Code");
            }

            const proposalTargetDateExists = await milestoneExists(
                opportunityId,
                CONFIG.milestone.values.proposalSubmissionDate,
                CONFIG.milestone.fields.targetDate
            );

            if (!proposalTargetDateExists) {
                result.missing.push("Proposal/Submission Date - Target Date");
            }
        }

        finalizeValidationResult(result);
        return result;
    }

    async function validateSolutionDesign(formContext, stageName) {
        const result = newValidationResult(stageName);

        if (!(await accountIsActive(formContext))) {
            result.missing.push("Account Status must be Active");
            markFirstMissingFormField(result, CONFIG.account.opportunityLookupLogicalName);
        }

        validateConfiguredStageFields(
            formContext,
            "solutionDesign",
            getOpportunityType(formContext),
            result
        );

        const opportunityId = requireSavedOpportunity(formContext, result);

        if (opportunityId) {
            const economicBuyer = CONFIG.related.economicBuyer;
            const economicBuyerExists = await relatedRecordExists(
                economicBuyer.entityLogicalName,
                economicBuyer.opportunityLookupProperty + " eq " + opportunityId +
                    " and " + economicBuyer.roleField + " eq " + economicBuyer.economicBuyerValue
            );

            if (!economicBuyerExists) {
                result.missing.push("At least one External Stakeholder identified as Economic Buyer");
            }

            const competitorExists = await hasCompetitor(opportunityId);
            if (!competitorExists) {
                result.missing.push("At least one Competitor with a populated name");
            }

            const revenueStartTargetExists = await milestoneExists(
                opportunityId,
                CONFIG.milestone.values.revenueStartDate,
                CONFIG.milestone.fields.targetDate
            );

            if (!revenueStartTargetExists) {
                result.missing.push("Revenue Start Date - Target Date");
            }

            const estimatedDecisionTargetExists = await milestoneExists(
                opportunityId,
                CONFIG.milestone.values.estimatedDecisionDate,
                CONFIG.milestone.fields.targetDate
            );

            if (!estimatedDecisionTargetExists) {
                result.missing.push("Estimated Decision Date - Target Date");
            }
        }

        finalizeValidationResult(result);
        return result;
    }

    async function validatePropose(formContext, stageName) {
        const result = newValidationResult(stageName);
        const type = getOpportunityType(formContext);

        if (!(await accountIsActive(formContext))) {
            result.missing.push("Account Status must be Active");
            markFirstMissingFormField(result, CONFIG.account.opportunityLookupLogicalName);
        }

        if (
            type !== CONFIG.opportunityType.strategic &&
            type !== CONFIG.opportunityType.transactional
        ) {
            result.missing.push("Opportunity Type");
            markFirstMissingFormField(result, CONFIG.opportunityType.logicalName);
        }

        // Propose requirements are the same for both opportunity types.
        validateConfiguredStageFields(formContext, "propose", type, result);

        const opportunityId = requireSavedOpportunity(formContext, result);

        if (opportunityId) {
            const proposalCompletedDateExists = await milestoneExists(
                opportunityId,
                CONFIG.milestone.values.proposalSubmissionDate,
                CONFIG.milestone.fields.completedDate
            );

            if (!proposalCompletedDateExists) {
                result.missing.push("Proposal/Submission Date - Completed Date");
            }
        }

        finalizeValidationResult(result);
        return result;
    }

    async function validateNegotiate(formContext, stageName) {
        const result = newValidationResult(stageName);

        if (!(await accountIsActive(formContext))) {
            result.missing.push("Account Status must be Active");
            markFirstMissingFormField(result, CONFIG.account.opportunityLookupLogicalName);
        }

        const opportunityId = requireSavedOpportunity(formContext, result);

        if (opportunityId) {
            const milestoneResults = await Promise.all([
                milestoneExists(
                    opportunityId,
                    CONFIG.milestone.values.implementationKickoff,
                    CONFIG.milestone.fields.targetDate
                ),
                milestoneExists(
                    opportunityId,
                    CONFIG.milestone.values.implementationPhaseStart,
                    CONFIG.milestone.fields.targetDate
                ),
                milestoneExists(
                    opportunityId,
                    CONFIG.milestone.values.implementationPilotStart,
                    CONFIG.milestone.fields.targetDate
                )
            ]);

            if (!milestoneResults[0] && !milestoneResults[1] && !milestoneResults[2]) {
                result.missing.push(
                    "At least one Implementation Target Date (Kickoff, Phase Start, or Pilot Start)"
                );
            }
        }

        finalizeValidationResult(result);
        return result;
    }

    // ============================================================
    // RELATED RECORD VALIDATION
    // ============================================================

    async function milestoneExists(opportunityId, milestoneValue, requiredDateField) {
        if (!opportunityId) {
            return false;
        }

        const milestone = CONFIG.milestone;

        const filter =
            milestone.opportunityLookupProperty + " eq " + opportunityId +
            " and " +
            milestone.fields.milestoneName + " eq " + milestoneValue +
            " and " +
            requiredDateField + " ne null";

        return await relatedRecordExists(
            milestone.entityLogicalName,
            filter
        );
    }

    async function accountIsActive(formContext) {
        const accountAttribute = formContext.getAttribute(
            CONFIG.account.opportunityLookupLogicalName
        );

        if (!accountAttribute) {
            return false;
        }

        const accountValue = accountAttribute.getValue();

        if (
            !accountValue ||
            !Array.isArray(accountValue) ||
            accountValue.length === 0 ||
            !accountValue[0].id
        ) {
            return false;
        }

        const accountId = normalizeGuid(accountValue[0].id);

        const account = await Xrm.WebApi.retrieveRecord(
            CONFIG.account.entityLogicalName,
            accountId,
            "?$select=" + CONFIG.account.statusReasonField
        );

        if (!account) {
            return false;
        }

        return account[CONFIG.account.statusReasonField] ===
            CONFIG.account.activeStatusReasonValue;
    }

    async function relatedRecordExists(entityLogicalName, filter) {
        const options = "?$top=1&$filter=" + encodeURIComponent(filter);

        const result = await Xrm.WebApi.retrieveMultipleRecords(
            entityLogicalName,
            options,
            1
        );

        return !!(result && result.entities && result.entities.length > 0);
    }

    async function hasCompetitor(opportunityId) {
        const competitor = CONFIG.related.competitor;

        const fetchXml = `
            <fetch top='1' distinct='true'>
                <entity name='competitor'>
                    <attribute name='competitorid' />
                    <attribute name='name' />
                    <filter type='and'>
                        <condition attribute='name' operator='not-null' />
                    </filter>
                    <link-entity
                        name='${competitor.intersectEntityLogicalName}'
                        from='competitorid'
                        to='competitorid'
                        intersect='true'>
                        <link-entity
                            name='opportunity'
                            from='opportunityid'
                            to='opportunityid'>
                            <filter type='and'>
                                <condition
                                    attribute='opportunityid'
                                    operator='eq'
                                    value='${opportunityId}' />
                            </filter>
                        </link-entity>
                    </link-entity>
                </entity>
            </fetch>`;

        const result = await Xrm.WebApi.retrieveMultipleRecords(
            competitor.entityLogicalName,
            "?fetchXml=" + fetchXml,
            1
        );

        if (!result || !result.entities || result.entities.length === 0) {
            return false;
        }

        const name = result.entities[0].name;
        return typeof name === "string" && name.trim().length > 0;
    }

    // ============================================================
    // STAGE ADVANCEMENT
    // ============================================================

    async function advanceOneStage(formContext, source) {
        if (STATE.stageMoveRunning) {
            return false;
        }

        const process = formContext.data && formContext.data.process;
        if (!process) {
            throw new Error("Business Process Flow API is not available on the form.");
        }

        const activeStage = process.getActiveStage();
        const selectedStage = process.getSelectedStage();

        if (!activeStage) {
            throw new Error("No active BPF stage is available.");
        }

        // moveNext requires the selected stage to match the active stage.
        if (
            !selectedStage ||
            normalizeGuid(selectedStage.getId()) !== normalizeGuid(activeStage.getId())
        ) {
            setFormNotification(
                formContext,
                "All requirements for the active stage are complete. Select the active BPF stage to allow automatic advancement.",
                "INFO",
                CONFIG.notifications.selection
            );
            return false;
        }

        try {
            STATE.stageMoveRunning = true;

            clearFormNotification(formContext, CONFIG.notifications.selection);
            clearFormNotification(formContext, CONFIG.notifications.runtime);

            // Save pending changes before evaluating BPF branching.
            if (formContext.data.entity.getIsDirty()) {
                log("Saving Opportunity before stage advancement. Source: " + source);
                await formContext.data.save();
            }

            // Confirm the stage remained unchanged during save.
            const activeAfterSave = process.getActiveStage();
            if (
                !activeAfterSave ||
                normalizeGuid(activeAfterSave.getId()) !== normalizeGuid(activeStage.getId())
            ) {
                throw new Error("The active BPF stage changed while the Opportunity was being saved.");
            }

            STATE.bypassPreStageChangeOnce = true;

            const status = await new Promise(function (resolve) {
                process.moveNext(function (moveStatus) {
                    resolve(moveStatus || "unknown");
                });
            });

            STATE.bypassPreStageChangeOnce = false;

            switch (normalizeText(status)) {
                case "success":
                    STATE.suppressAutoUntil = Date.now() + CONFIG.autoAdvanceCooldownMs;
                    log("BPF advanced successfully. Source: " + source);
                    return true;

                case "end":
                    log("BPF is already at the end of the active path.");
                    return true;

                case "stagegate":
                    throw new Error(
                        "Dynamics blocked the stage move because one or more native BPF required fields are empty."
                    );

                case "dirtyform":
                    throw new Error("Dynamics reports that the Opportunity still has unsaved changes.");

                case "invalid":
                    throw new Error(
                        "The selected BPF stage no longer matches the active stage. Select the active stage and try again."
                    );

                case "crossentity":
                    throw new Error(
                        "The next BPF stage is on another table. moveNext() does not support this cross-table transition."
                    );

                case "preventdefault":
                    throw new Error(
                        "Another BPF OnPreStageChange handler prevented the stage transition."
                    );

                default:
                    throw new Error("Unexpected BPF moveNext status: " + status);
            }
        } finally {
            STATE.bypassPreStageChangeOnce = false;
            STATE.stageMoveRunning = false;
        }
    }

    // ============================================================
    // CONFIGURED STAGE FIELD VALIDATION
    // ============================================================

    function validateConfiguredStageFields(formContext, stageKey, opportunityType, result) {
        const stageConfig = CONFIG.stageConfiguration[stageKey];
        const typeKey = getOpportunityTypeConfigKey(opportunityType);

        if (!stageConfig || !typeKey) {
            return;
        }

        const fieldRules = getStageTypeSetting(
            stageConfig.requiredFields,
            typeKey,
            []
        ) || [];

        fieldRules.forEach(function (rule) {
            if (!rule || !rule.fieldKey) {
                return;
            }

            const logicalName = CONFIG.fields[rule.fieldKey];
            const label = getFieldLabel(logicalName, rule.fieldKey);

            switch (rule.validator) {
                case "positiveNumber":
                    requirePositiveNumber(formContext, logicalName, label, result);
                    break;

                case "choice":
                    requireChoice(
                        formContext,
                        logicalName,
                        label,
                        CONFIG[rule.allowedValuesKey] || [],
                        result
                    );
                    break;

                case "populated":
                default:
                    requirePopulated(formContext, logicalName, label, result);
                    break;
            }
        });
    }

    function getStageTypeSetting(settings, typeKey, defaultValue) {
        if (!settings) {
            return defaultValue;
        }

        if (Object.prototype.hasOwnProperty.call(settings, typeKey)) {
            return settings[typeKey];
        }

        if (Object.prototype.hasOwnProperty.call(settings, "all")) {
            return settings.all;
        }

        return defaultValue;
    }

    function getOpportunityTypeConfigKey(value) {
        if (value === CONFIG.opportunityType.strategic) {
            return "strategic";
        }

        if (value === CONFIG.opportunityType.transactional) {
            return "transactional";
        }

        return "";
    }

    function getFieldLabel(logicalName, fallback) {
        if (logicalName && CONFIG.labels[logicalName]) {
            return CONFIG.labels[logicalName];
        }

        return fallback || logicalName || "Field";
    }

    // ============================================================
    // FIELD VALIDATION HELPERS
    // ============================================================

    function requirePopulated(formContext, logicalName, label, result) {
        const attribute = getConfiguredAttribute(formContext, logicalName, label, result);
        if (!attribute) {
            result.missing.push(label);
            return;
        }

        if (!hasValue(attribute.getValue())) {
            result.missing.push(label);
            markFirstMissingFormField(result, logicalName);
        }
    }

    function requirePositiveNumber(formContext, logicalName, label, result) {
        const attribute = getConfiguredAttribute(formContext, logicalName, label, result);
        if (!attribute) {
            result.missing.push(label + " (> 0)");
            return;
        }

        const value = attribute.getValue();
        if (value === null || value === undefined || Number(value) <= 0) {
            result.missing.push(label + " (> 0)");
            markFirstMissingFormField(result, logicalName);
        }
    }

    function requireChoice(formContext, logicalName, label, allowedValues, result) {
        const attribute = getConfiguredAttribute(formContext, logicalName, label, result);
        if (!attribute) {
            result.missing.push(label);
            return;
        }

        const value = attribute.getValue();
        if (value === null || value === undefined || allowedValues.indexOf(value) === -1) {
            result.missing.push(label);
            markFirstMissingFormField(result, logicalName);
        }
    }

    function getConfiguredAttribute(formContext, logicalName, label, result) {
        if (isPlaceholder(logicalName)) {
            result.configurationErrors.push(
                label + " has not been mapped to its Dataverse logical name."
            );
            return null;
        }

        const attribute = formContext.getAttribute(logicalName);
        if (!attribute) {
            result.configurationErrors.push(
                label + " (" + logicalName + ") is not available on the Opportunity form."
            );
            return null;
        }

        return attribute;
    }

    function requireSavedOpportunity(formContext, result) {
        const id = getOpportunityId(formContext);

        if (!id) {
            if (result.missing.indexOf("Save the Opportunity before completing this stage") === -1) {
                result.missing.push("Save the Opportunity before completing this stage");
            }
            return null;
        }

        return id;
    }

    function hasValue(value) {
        if (value === null || value === undefined) {
            return false;
        }

        if (typeof value === "string") {
            return value.trim().length > 0;
        }

        if (Array.isArray(value)) {
            return value.length > 0;
        }

        // Zero and false are valid populated values.
        return true;
    }

    // ============================================================
    // VALIDATION RESULT HELPERS
    // ============================================================

    function newValidationResult(stageName) {
        return {
            stageName: stageName,
            isComplete: false,
            terminal: false,
            pathMismatch: false,
            pathMessage: "",
            missing: [],
            configurationErrors: [],
            firstMissingFieldLogicalName: null
        };
    }

    function markFirstMissingFormField(result, logicalName) {
        if (result && !result.firstMissingFieldLogicalName && logicalName) {
            result.firstMissingFieldLogicalName = logicalName;
        }
    }

    function finalizeValidationResult(result) {
        result.missing = uniqueStrings(result.missing);
        result.configurationErrors = uniqueStrings(result.configurationErrors);
        result.isComplete =
            result.missing.length === 0 &&
            result.configurationErrors.length === 0;
    }

    function terminalResult(stageName) {
        const result = newValidationResult(stageName);
        result.terminal = true;
        result.isComplete = true;
        return result;
    }

    function pathMismatchResult(stageName, message) {
        const result = newValidationResult(stageName);
        result.pathMismatch = true;
        result.pathMessage = message;
        return result;
    }

    // ============================================================
    // DIALOGS / NOTIFICATIONS
    // ============================================================

    async function showMissingRequirements(validation) {
        const lines = validation.missing.map(function (item) {
            return "• " + item;
        });

        let text =
            "The " + validation.stageName + " stage cannot be completed.\n\n" +
            "Complete the following requirements:\n\n" +
            lines.join("\n");

        if (validation.configurationErrors.length > 0) {
            text +=
                "\n\nStage-gate configuration is incomplete. Please contact a system administrator.";
        }

        return Xrm.Navigation.openAlertDialog(
            {
                title: validation.stageName + " - Missing Requirements",
                text: text,
                confirmButtonLabel: "OK"
            },
            {
                width: 560
            }
        );
    }

    function focusFirstMissingFormField(formContext, validation) {
        const logicalName = validation && validation.firstMissingFieldLogicalName;
        if (!formContext || !logicalName) {
            return;
        }

        try {
            const attribute = formContext.getAttribute(logicalName);
            let control = null;

            if (
                attribute &&
                attribute.controls &&
                typeof attribute.controls.get === "function"
            ) {
                control = attribute.controls.get(0);
            }

            if (!control && typeof formContext.getControl === "function") {
                control = formContext.getControl(logicalName);
            }

            if (control && typeof control.setFocus === "function") {
                control.setFocus();
            }
        } catch (error) {
            warn(
                "Unable to focus the first missing Opportunity field (" +
                logicalName + "): " + getErrorMessage(error)
            );
        }
    }

    async function showPathMismatch(validation) {
        return Xrm.Navigation.openAlertDialog(
            {
                title: "Opportunity Process Path",
                text: validation.pathMessage,
                confirmButtonLabel: "OK"
            },
            {
                width: 520
            }
        );
    }

    async function showBackwardNavigationBlocked() {
        return Xrm.Navigation.openAlertDialog(
            {
                title: "Stage Change Not Allowed",
                text: "Completed Opportunity stages cannot be reactivated. Update the Opportunity data in the current stage instead.",
                confirmButtonLabel: "OK"
            },
            {
                width: 520
            }
        );
    }

    async function handleRuntimeError(formContext, title, error, showDialog) {
        const message = getErrorMessage(error);
        errorLog(title + " " + message);

        setFormNotification(
            formContext,
            title + " " + message,
            "ERROR",
            CONFIG.notifications.runtime
        );

        if (showDialog) {
            await Xrm.Navigation.openAlertDialog(
                {
                    title: title,
                    text: message,
                    confirmButtonLabel: "OK"
                },
                {
                    width: 560
                }
            );
        }
    }

    function setFormNotification(formContext, message, level, id) {
        try {
            formContext.ui.setFormNotification(message, level, id);
        } catch (e) {
            warn("Unable to set form notification: " + getErrorMessage(e));
        }
    }

    function clearFormNotification(formContext, id) {
        try {
            formContext.ui.clearFormNotification(id);
        } catch (e) {
            // no-op
        }
    }

    function clearTransientNotifications(formContext) {
        clearFormNotification(formContext, CONFIG.notifications.path);
        clearFormNotification(formContext, CONFIG.notifications.selection);
        clearFormNotification(formContext, CONFIG.notifications.runtime);
    }

    // ============================================================
    // CONFIGURATION VALIDATION
    // ============================================================

    function validateConfigurationOnLoad(formContext) {
        const placeholders = getConfiguredStageFieldNames().filter(isPlaceholder);

        if (placeholders.length > 0) {
            setFormNotification(
                formContext,
                "Opportunity stage-gate configuration contains unmapped logical name(s). Contact a system administrator.",
                "WARNING",
                CONFIG.notifications.configuration
            );
            warn("Unmapped configuration placeholders: " + placeholders.join(", "));
        } else {
            clearFormNotification(formContext, CONFIG.notifications.configuration);
        }
    }

    function getConfiguredStageFieldNames() {
        const logicalNames = [
            CONFIG.account.opportunityLookupLogicalName,
            CONFIG.opportunityType.logicalName
        ];

        Object.keys(CONFIG.stageConfiguration).forEach(function (stageKey) {
            const stageConfig = CONFIG.stageConfiguration[stageKey];
            const requiredFields = stageConfig && stageConfig.requiredFields;

            if (!requiredFields) {
                return;
            }

            Object.keys(requiredFields).forEach(function (typeKey) {
                const rules = requiredFields[typeKey] || [];

                rules.forEach(function (rule) {
                    if (rule && rule.fieldKey && CONFIG.fields[rule.fieldKey]) {
                        logicalNames.push(CONFIG.fields[rule.fieldKey]);
                    }
                });
            });
        });

        return uniqueStrings(logicalNames);
    }

    // ============================================================
    // SUBGRID BASELINE HELPERS
    // ============================================================

    function markSubgridBaseline(formContext, control) {
        const key = getSubgridBaselineKey(formContext, control);
        STATE.subgridBaseline[key] = true;
    }

    function primeSubgridBaselinesForCurrentStage(formContext) {
        if (!formContext.ui || !formContext.ui.controls) {
            return;
        }

        formContext.ui.controls.forEach(function (control) {
            try {
                if (
                    control &&
                    typeof control.getControlType === "function" &&
                    control.getControlType() === "subgrid" &&
                    typeof control.getEntityName === "function" &&
                    CONFIG.relatedGridEntities.indexOf(control.getEntityName()) !== -1
                ) {
                    markSubgridBaseline(formContext, control);
                }
            } catch (e) {
                // no-op
            }
        });
    }

    function getSubgridBaselineKey(formContext, control) {
        const activeStage = getActiveStage(formContext);
        const stageId = activeStage ? normalizeGuid(activeStage.getId()) : "nostage";
        const controlName = control && typeof control.getName === "function"
            ? control.getName()
            : "unknowncontrol";

        return stageId + ":" + controlName;
    }

    // ============================================================
    // GENERAL HELPERS
    // ============================================================

    function getFormContext(executionContext) {
        if (!executionContext || typeof executionContext.getFormContext !== "function") {
            return null;
        }

        return executionContext.getFormContext();
    }

    function getActiveStage(formContext) {
        if (!formContext || !formContext.data || !formContext.data.process) {
            return null;
        }

        return formContext.data.process.getActiveStage();
    }

    function getOpportunityType(formContext) {
        const attribute = formContext.getAttribute(CONFIG.opportunityType.logicalName);
        return attribute ? attribute.getValue() : null;
    }

    function getOpportunityId(formContext) {
        const id = formContext.data.entity.getId();
        return id ? normalizeGuid(id) : null;
    }

    function getStageKey(stageName) {
        const normalized = normalizeText(stageName);

        const salesMatch = CONFIG.stages.salesProcessAliases.some(function (alias) {
            return normalizeText(alias) === normalized;
        });

        if (salesMatch) {
            return "salesProcess";
        }

        if (normalizeText(CONFIG.stages.discovery) === normalized) {
            return "discovery";
        }

        if (normalizeText(CONFIG.stages.solutionDesign) === normalized) {
            return "solutionDesign";
        }

        if (normalizeText(CONFIG.stages.propose) === normalized) {
            return "propose";
        }

        if (normalizeText(CONFIG.stages.negotiate) === normalized) {
            return "negotiate";
        }

        if (normalizeText(CONFIG.stages.implementation) === normalized) {
            return "implementation";
        }

        return "unknown";
    }

    function safeStageName(stage) {
        if (!stage || typeof stage.getName !== "function") {
            return "Unknown Stage";
        }

        return stage.getName() || "Unknown Stage";
    }

    function isPlaceholder(value) {
        return typeof value === "string" && value.indexOf("TODO_") === 0;
    }

    function normalizeGuid(value) {
        return value
            ? String(value).replace(/[{}]/g, "").toLowerCase()
            : "";
    }

    function normalizeText(value) {
        return value
            ? String(value).trim().toLowerCase()
            : "";
    }

    function uniqueStrings(values) {
        const seen = Object.create(null);
        const result = [];

        values.forEach(function (value) {
            if (!value || seen[value]) {
                return;
            }
            seen[value] = true;
            result.push(value);
        });

        return result;
    }

    function getErrorMessage(error) {
        if (!error) {
            return "Unknown error.";
        }

        if (typeof error === "string") {
            return error;
        }

        if (error.message) {
            return error.message;
        }

        try {
            return JSON.stringify(error);
        } catch (e) {
            return String(error);
        }
    }

    function log(message) {
        if (CONFIG.debug && window.console && console.log) {
            console.log("[CHR Opportunity BPF Gate] " + message);
        }
    }

    function warn(message) {
        if (window.console && console.warn) {
            console.warn("[CHR Opportunity BPF Gate] " + message);
        }
    }

    function errorLog(message) {
        if (window.console && console.error) {
            console.error("[CHR Opportunity BPF Gate] " + message);
        }
    }

    // ============================================================
    // PUBLIC API
    // ============================================================

    return {
        onLoad: onLoad,

        // Diagnostic access.
        evaluateCurrentStage: function (executionContext) {
            const formContext = getFormContext(executionContext);
            if (!formContext) {
                return Promise.resolve();
            }

            return evaluateCurrentStage(formContext, {
                source: "manual-test",
                autoAdvance: true,
                showMissing: false
            });
        },

        validateCurrentStage: function (executionContext) {
            const formContext = getFormContext(executionContext);
            if (!formContext) {
                return Promise.reject(new Error("Form context is unavailable."));
            }

            return validateCurrentStage(formContext);
        },

        navigateToGuidanceRequirement: navigateToGuidanceRequirement,

        config: CONFIG
    };

})();
