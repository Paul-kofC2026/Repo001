}

function GetLoggedInUserTeamSecurityRole(formContext) {
    "use strict";
    try {
        // Get the current user's role
        var loggedUserRoles = Xrm.Utility.getGlobalContext().userSettings.roles;
        var flag_Insurance = true;
        var flag_Fraternal = true;
        var flag_Investment = true;
        var flag_Retail = true;
        var flag_Charity = true;
        var flag_KCCF = true;
        var optionSetControl = formContext.getControl("kofc_opportunitytype");
        // Clear existing options from the option set   
        optionSetControl.clearOptions();
        loggedUserRoles.forEach(function hasRoleName(item, index) {
            if ((item.name === "Insurance Leader" || item.name === "Insurance Sales" || item.name === "Agency Support" || item.name === "Home Office" || item.name === "System Administrator" || item.name === "System Customizer") && flag_Insurance) {
                optionSetControl.addOption(opportunityOptionSetType.NeedInsurance);
                optionSetControl.addOption(opportunityOptionSetType.Recruiting);
                flag_Insurance = false;
            }
            if ((item.name === "Fraternal Manager" || item.name === "System Administrator" || item.name === "System Customizer") && flag_Fraternal) {
                optionSetControl.addOption(opportunityOptionSetType.NewCouncilDevelopment);
                optionSetControl.addOption(opportunityOptionSetType.CouncilReactivation);
                optionSetControl.addOption(opportunityOptionSetType.NewMember);
                optionSetControl.addOption(opportunityOptionSetType.EstablishCor);
                flag_Fraternal = false;
            }
            if ((item.name === "Investment Manager" || item.name === "Investment Support" || item.name === "Investment Leader​​" || item.name === "System Administrator" || item.name === "System Customizer") && flag_Investment) {
                optionSetControl.addOption(opportunityOptionSetType.InstitutionalInvestment);
                flag_Investment = false;
            }
            if ((item.name === "Retail Investment Sales" || item.name === "System Administrator" || item.name === "System Customizer") && flag_Retail) {
                optionSetControl.addOption(opportunityOptionSetType.RetailInvestment);
                flag_Retail = false;
            }
            if ((item.name === "Charity Leader" || item.name == "Charity User" || item.name === "System Administrator" || item.name === "System Customizer") && flag_Charity) {
                optionSetControl.addOption(opportunityOptionSetType.Charity);
                flag_Charity = false;
            }
            if ((item.name === "KCCF Leader" || item.name === "KCCF User" || item.name === "System Administrator" || item.name === "System Customizer") && flag_KCCF) {
                optionSetControl.addOption(opportunityOptionSetType.KCCF);
                flag_KCCF = false;
            }
        });
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in GetLoggedInUserTeamSecurityRole: ' + (error.description || error.message));
    }
}
