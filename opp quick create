//Function to remove option set values from opportunity sub type for recruiting opportunity. 
//Modified for fixing Bug 9725
function OnChangeOpportunityType(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();

        if (formContext.getAttribute('closeprobability') != null)
            formContext.getAttribute('closeprobability').setValue(50);
        if (formContext.getAttribute("kofc_opportunitytype").getValue() !== null && formContext.getAttribute("kofc_opportunitytype").getValue() !== undefined) {
            var oppType = formContext.getAttribute("kofc_opportunitytype").getValue();
            if (formContext.getAttribute('parentaccountid') != null && oppType === opportunityTypevalue.InstitutionalInvestment)
                formContext.getAttribute('parentaccountid').setRequiredLevel("required");
            else
                formContext.getAttribute('parentaccountid').setRequiredLevel("none");
            if (oppType === opportunityTypevalue.Recruiting) {
                formContext.getControl("kofc_opportunitytype").setDisabled(true);
                formContext.getControl("kofc_opportunitysubtype").setVisible(true);
                var oppSubTypeOptionSet = formContext.getControl("kofc_opportunitysubtype");
                oppSubTypeOptionSet.removeOption(opportunitySubType.Donation);
                oppSubTypeOptionSet.removeOption(opportunitySubType.Pledge);
                oppSubTypeOptionSet.removeOption(opportunitySubType.MajorGift);
                oppSubTypeOptionSet.removeOption(opportunitySubType.PlannedGift);
            }
            else {
                formContext.getControl("kofc_opportunitysubtype").setVisible(false);
                if (formContext.getAttribute('kofc_productcategory') != null) {
                    if (oppType === opportunityTypevalue.RetailInvestment)
                        formContext.getAttribute('kofc_productcategory').setValue(productCategoryValues.RetailInvestment);
                    if (oppType === opportunityTypevalue.KCCF)
                        formContext.getAttribute('kofc_productcategory').setValue(productCategoryValues.KCCF);
                }
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in OnChangeOpportunityType: ' + (error.description || error.message));
    }
}

//Function to remove option set values from opportunity sub type for recruiting opportunity.
function RemoveOpportunitySubTypeValues(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute('closeprobability') != null)
            formContext.getAttribute('closeprobability').setValue(50);
        if (formContext.getAttribute("kofc_opportunitytype").getValue() !== null && formContext.getAttribute("kofc_opportunitytype").getValue() !== undefined) {
            var oppType = formContext.getAttribute("kofc_opportunitytype").getValue();
            if (oppType === opportunityType.Recruiting) {
                formContext.getControl("kofc_opportunitytype").setDisabled(true);
                formContext.getControl("kofc_opportunitysubtype").setVisible(true);
                var oppSubTypeOptionSet = formContext.getControl("kofc_opportunitysubtype");
                oppSubTypeOptionSet.removeOption(opportunitySubType.Donation);
                oppSubTypeOptionSet.removeOption(opportunitySubType.Pledge);
                oppSubTypeOptionSet.removeOption(opportunitySubType.MajorGift);
                oppSubTypeOptionSet.removeOption(opportunitySubType.PlannedGift);
            }
            else {
                formContext.getControl("kofc_opportunitysubtype").setVisible(false);
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in RemoveOpportunitySubTypeValues: ' + (error.description || error.message));
    }
}

