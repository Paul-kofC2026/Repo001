function OnSave(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        var opportunitytype;
        var globalContext = Xrm.Utility.getGlobalContext();
        var queryString = globalContext.getQueryStringParameters();
        var isCloseAsWonClicked = queryString["param_won"];

        var OppID = formContext.getAttribute("opportunityid");
        if (formContext.getAttribute("opportunityid") != null && formContext.getAttribute("opportunityid").getValue() !== null && formContext.getAttribute("opportunityid").getValue() !== undefined) {
            var opportunityId = formContext.getAttribute("opportunityid").getValue()[0].id.replace("{", "").replace("}", "");
            var membershipActualCloseUpdated = formContext.getAttribute("kofc_annualmembership").getValue();
            var marketValue = formContext.getAttribute("kofc_marketvalue").getValue();
            var req = new XMLHttpRequest();
            req.open("GET", clientUrl + "/api/data/v9.2/opportunities(" + opportunityId + ")?$select=kofc_membershipactual,kofc_opportunitytype,kofc_marketvalue,actualvalue,_parentcontactid_value&$expand=parentcontactid($select=kofc_contacttype)", false);
            req.setRequestHeader("OData-MaxVersion", "4.0");
            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Prefer", "odata.include-annotations=*");
            req.send();
            if (req.status === 200) {
                var result = JSON.parse(req.response);
                // Columns
                opportunitytype = result["kofc_opportunitytype"];
                var opportunityContact = result["_parentcontactid_value"];			// Choice
                if (isCloseAsWonClicked && opportunitytype !== undefined && opportunitytype === opportunityTypevalue.NewCouncilDevelopment && membershipActualCloseUpdated !== null) {
                    var record = {};
                    record.kofc_membershipactual = membershipActualCloseUpdated; // WholeNumber                
                }
                else if (isCloseAsWonClicked && opportunitytype !== undefined && opportunitytype === opportunityTypevalue.InstitutionalInvestment) {
                    var record = {};
                    record.kofc_marketvalue = marketValue; // Currency
                    record.actualvalue = marketValue; // Currency               
                }
                else if (isCloseAsWonClicked && opportunitytype !== undefined && opportunitytype === opportunityTypevalue.NewMember && opportunityContact !== null && opportunityContact !== undefined && result.hasOwnProperty("parentcontactid") && result["parentcontactid"] !== null) {
                    var parentcontactid_kofc_contacttype = result["parentcontactid"]["kofc_contacttype"]; // Choices
                    if (parentcontactid_kofc_contacttype === null || parentcontactid_kofc_contacttype === undefined || !parentcontactid_kofc_contacttype.includes(contactTypeValues.MembershipOption)) {
                        var contactCloseOptyKeyMessage = Xrm.Utility.getResourceString(Messages.Resource, Messages.ContactCloseOptyKey);
                        alert(contactCloseOptyKeyMessage);//"Contact should be mapped as Member before closing the opportunity"
                        executionContext.getEventArgs().preventDefault();
                    }
                }

                Xrm.WebApi.updateRecord("opportunity", opportunityId, record).then(
                    function success(result) {
                        console.log("Opportunity Updated");
                    },
                    function error(error) {
                        console.log("Error: " + error.message);
                    }
                );

                // var req = new XMLHttpRequest();
                // req.open("PATCH", clientUrl + "/api/data/v9.2/opportunities(" + opportunityId + ")", false);
                // req.setRequestHeader("OData-MaxVersion", "4.0");
                // req.setRequestHeader("OData-Version", "4.0");
                // req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
                // req.setRequestHeader("Accept", "application/json");
                // req.setRequestHeader("Prefer", "odata.include-annotations=*");
                // req.send(JSON.stringify(record));
            }
            else {
                Xrm.Navigation.openAlertDialog('Error in OnLoad: ' + (req.responseText || req.responseText));
            }
        }
    }
    catch (err) {
        Xrm.Navigation.openAlertDialog('Error in OnLoad: ' + (err.description || err.message));
        return false;
    }
}
