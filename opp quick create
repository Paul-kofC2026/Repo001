            }
            //Check if Opportunity Close Quick Create form type is 1 and
            var formType = formContext.ui.getFormType();
            if (formType === 1 && isCloseAsWonClicked && opportunitytype !== undefined && opportunitytype === opportunityTypevalue.CouncilReactivation && status !== undefined && status === StatusValue.Active) {
