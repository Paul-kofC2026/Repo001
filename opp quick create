function OnChange(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        if (formContext.getAttribute("kofc_lostreasons").getValue() !== undefined && formContext.getAttribute("kofc_lostreasons").getValue() !== null) {
            var lostReason = formContext.getAttribute("kofc_lostreasons").getValue();
            if (lostReason.includes(lostReasons.Other)) {
                formContext.getAttribute("description").setRequiredLevel("required");
            }
            else {
                formContext.getAttribute("description").setRequiredLevel("none");
            }
        }
        else {
            formContext.getAttribute("description").setRequiredLevel("none");
        }
    }
    catch (err) {
        Xrm.Navigation.openAlertDialog('Error in OnChange: ' + (err.description || err.message));
        return false;
    }
}


