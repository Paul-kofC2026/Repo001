            req.setRequestHeader("OData-Version", "4.0");
            req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            req.setRequestHeader("Accept", "application/json");
            req.setRequestHeader("Prefer", "odata.include-annotations=*");
            req.send();
            if (req.status === 200) {
                var result = JSON.parse(req.response);
                // Columns
                councilId = result["_kofc_council_value"]; // Lookup
                opportunitytype = result["kofc_opportunitytype"]; // Choice
                oppSubType = result["kofc_opportunitysubtype"]; // Choice 
                marketValue = result["kofc_marketvalue"]; //Added as part of US 6871 by Dipti
                actualValueOpp = result["actualvalue"]; //Added as part of US 6422 by Dipti
                //Added for US 5742
                membershipActualOpp = result["kofc_membershipactual"]; // WholeNumber
                //Added parish filter as part of 3167 story - by sreedeepthi            
                initialFunding = result["kofc_initialfunding"];
                // Many To One Relationships
                if (result.hasOwnProperty("kofc_Council") && result["kofc_Council"] !== null) {
                    status = result["kofc_Council"]["kofc_status"]; // Choice   
                    parishValue = result["kofc_Parish"]["kofc_corestablished"];  //Moved Cor Established field from Parish to Council            
                }
                //Added parish filter as part of 3167 story - by sreedeepthi
                // Many To One Relationships
                // if (result.hasOwnProperty("kofc_Parish") && result["kofc_Parish"] !== null) {
