function SetEmailSubjectIfRegardingisCase(executionContext) {
    "use strict";
    try {
        var formContext = executionContext.getFormContext();
        // Get Activity Type and Check it is Email
        var EntityType = formContext.data.entity.getEntityName();
        if (EntityType === activityType.Email) {
            // Get the field
            var regardingEntity = formContext.getAttribute("regardingobjectid").getValue();
            if (regardingEntity !== null) {
                var regardingEntityId = regardingEntity[0].id;
                var regardingEntityName = regardingEntity[0].entityType;

                if (regardingEntityName === regaringEntityType.Case) {
                    var req = new XMLHttpRequest();
                    var globalContext = Xrm.Utility.getGlobalContext();
                    req.open("GET", globalContext.getClientUrl() + "/api/data/v9.2/incidents(" + regardingEntityId.slice(1, -1) + ")?$select=ticketnumber", false);
                    req.setRequestHeader("OData-MaxVersion", "4.0");
                    req.setRequestHeader("OData-Version", "4.0");
                    req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
                    req.setRequestHeader("Accept", "application/json");
                    req.setRequestHeader("Prefer", "odata.include-annotations=*");
                    req.send();
                    if (req.status === 200) {
                        var result = JSON.parse(req.response);
                        var caseNumber = result["ticketnumber"];
                        var emailSubject = formContext.getAttribute("subject").getValue();
                        if (emailSubject !== null && caseNumber !== null && !emailSubject.includes(caseNumber)) {
                            emailSubject += " : " + caseNumber;
                            // Update Subject with Case Number
                            formContext.getAttribute("subject").setValue(emailSubject);
                        }
                    }
                }
            }
        }
    }
    catch (error) {
        Xrm.Navigation.openAlertDialog('Error in SetEmailSubjectIfRegardingisCase: ' + (error.description || error.message));
    }
}

