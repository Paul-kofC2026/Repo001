function onLoadPhoneCallQuickCreate(executionContext) {

    var formContext = executionContext.getFormContext();
    if (formContext !== "undefined" && formContext !== null) {

        let regardingObjectId = formContext.getAttribute("regardingobjectid").getValue();

        if (regardingObjectId && regardingObjectId[0] && regardingObjectId[0].id && regardingObjectId[0].entityType == "contact") {
            let contactId = regardingObjectId[0].id;

            // 2. Retrieve Contact Data (including preferred contact method and phone numbers)
            Xrm.WebApi.retrieveRecord("contact", contactId, "?$select=kofc_preferredphone,telephone1,telephone2,mobilephone").then(
                function success(result) {
                    const preferredContactMethod = result.kofc_preferredphone; // Option set value
                    const businessPhone = result.telephone1;
                    const homePhone = result.telephone2;
                    const mobilePhone = result.mobilephone;
                    let phoneNumberToUse = null;

                    const preferredMethodMobile = 2; // value. 258510002
                    const preferredMethodHomePhone = 1; // value. 258510001
                    const preferredMethodBusinessPhone = 0; // value. 258510000

                    if (preferredContactMethod === preferredMethodBusinessPhone) {
                        phoneNumberToUse = businessPhone;
                    } else if (preferredContactMethod === preferredMethodHomePhone) {
                        phoneNumberToUse = homePhone;
                    } else {
                        phoneNumberToUse = mobilePhone;
                    }
                    if (phoneNumberToUse) {
                        // Set the Phone Number on the Phone Call form.
                        formContext.getAttribute("phonenumber").setValue(phoneNumberToUse);
                    } else {
                        console.log("No phone number available for the contact.");
                    }
                },
                function (error) {
                    console.error("Error retrieving contact:", error.message);
                }
            );
        } else {
            console.log("Regarding (Contact) is not set on the Phone Call Quick Create form.");
        }

    }
}


function getCustomerServiceQueueRecord(formContext) {
    try {
        const fetchXml = `<fetch version="1.0" output-format="xml-platform" mapping="logical" distinct="false">
                      <entity name="queue">
                        <attribute name="name" />
                        <attribute name="emailaddress" />
                        <attribute name="queueid" />
                        <order attribute="name" descending="false" />
                        <filter type="and">
                          <condition attribute="name" operator="eq" value="Customer Service Queue" />
                          <condition attribute="emailaddress" operator="like" value="customer.service%" />
                          <condition attribute="statecode" operator="eq" value="0" />
                        </filter>
                      </entity>
                    </fetch>`;

        return Xrm.WebApi.retrieveMultipleRecords('queue', "?fetchXml=" + encodeURIComponent(fetchXml))
            .then(function (result) {
                if (result.entities.length === 0) {
                    return;
                }

                var record = result.entities[0];
                var fromEmail = new Array();
                fromEmail[0] = new Object();
                fromEmail[0].id = record["queueid"]; // GUID of the lookup id
                fromEmail[0].name = customerServiceQueue.EntityName; // Name of the lookup
                fromEmail[0].entityType = customerServiceQueue.EntityType; //Entity Type of the lookup entity
                if (formContext.getAttribute("from").getValue() != null) {
                    formContext.getAttribute("from").setValue(null);
                    formContext.getAttribute("from").setValue(fromEmail);
                }

            })
    } catch (error) {
        console.log("Error while getting Customer Service Queue");
    }
}

