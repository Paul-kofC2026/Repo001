function AddActivityType(executionContext) {
    "use strict";
    var activityForOptionSet;
    var ActivityTypeValue;
    var formContext = executionContext.getFormContext();
    var fetchQuery;
    try {
        var EntityType = formContext.data.entity.getEntityName();

        if (EntityType === activityType.PhoneCall) {
            ActivityTypeValue = activity.PhoneCall;
        }
        else if (EntityType === activityType.Email) {
            ActivityTypeValue = activity.Email;
        }
        else if (EntityType === activityType.Appintment) {
            ActivityTypeValue = activity.Appointment;
        }
        else if (EntityType === activityType.Task) {
            ActivityTypeValue = activity.Task;
        }

        activityForOptionSet = formContext.getControl('kofc_activityfor').getAttribute().getValue();
        if (activityForOptionSet !== null && activityForOptionSet !== undefined) {
            fetchQuery = "<filter type='and'><condition attribute = 'kofc_activityfor' operator = 'eq' value = '" + activityForOptionSet + "' /><condition attribute = 'kofc_activity' operator = 'eq' value = '" + ActivityTypeValue + "' /></filter>";
            formContext.getControl('kofc_activitytypevalue').addCustomFilter(fetchQuery);
            formContext.getAttribute('kofc_activityfor').addOnChange(ClearActivityType);
        }
    }
    catch (e) {
        Xrm.Navigation.openAlertDialog('AddActivityType Error: ' + (e.description || e.message));
    }
}

function ClearActivityType(executionContext) {
    "use strict";
    var formContext = executionContext.getFormContext();
    formContext.getAttribute('kofc_activitytypevalue').setValue(null);
}

// Function to lock or unlock "Activity For" based on its value
function LockFieldBasedOnValue(executionContext) {
    "use strict";
    var formContext = executionContext.getFormContext();
    // Get the field
    var activityFor = formContext.getAttribute("kofc_activityfor");

    if (activityFor) {
        // Check if the field has a value
        var activityForValue = activityFor.getValue();

        // Lock or unlock the field based on the value
        if (activityForValue !== null && activityForValue !== undefined && activityForValue !== "") {
            // Field has a value, so lock it
            formContext.getControl("kofc_activityfor").setDisabled(true);
        } else {
            // Field is empty, so unlock it
            formContext.getControl("kofc_activityfor").setDisabled(false);
        }
    }
}

