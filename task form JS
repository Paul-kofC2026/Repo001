function setLocationOnChangeOfAppointment(executionContext) {
    var formContext = executionContext.getFormContext();
    if (formContext !== "undefined" && formContext !== null) {
        // Get the regarding entity reference of the appointment
        var location = formContext.getAttribute("location").getValue();
        var regarding = formContext.getAttribute("regardingobjectid").getValue();
        if (regarding && regarding[0].entityType === "contact") {
            var regardingID = regarding[0].id.replace('{', '').replace('}', '');
            // Get the contact record
            Xrm.WebApi.retrieveRecord("contact", regardingID, "?$select=address1_line1,address1_line2,address1_line3,address1_city,kofc_address_stateorprovince,address1_postalcode")
                .then(function (result) {
                    // Construct the address string
                    var address = [];
                    if (result.address1_line1) address.push(result.address1_line1);
                    if (result.address1_line2) address.push(result.address1_line2);
                    if (result.address1_line3) address.push(result.address1_line3);
                    if (result.address1_city) address.push(result.address1_city);
                    if (result.kofc_address_stateorprovince) address.push(result["kofc_address_stateorprovince@OData.Community.Display.V1.FormattedValue"]);
                    if (result.address1_postalcode) address.push(result.address1_postalcode);

                    var formattedAddress = address.join(", ");

                    // Set the Location field of the appointment
                    formContext.getAttribute("location").setValue(formattedAddress);
                })
                .catch(function (error) {
                    // Handle any errors that occur during the retrieval
                    alert("Error retrieving contact address: " + error.message);
                });
        }
        else { formContext.getAttribute("location").setValue(null); }

    }
}
