var KOFC = KOFC || {};
KOFC.Task = KOFC.Task || {};

KOFC.Task.filterActivityFor = function (executionContext) {
    "use strict";

    try {
        var formContext = executionContext.getFormContext();

        // Only execute on Task
        if (formContext.data.entity.getEntityName() !== "task") {
            return;
        }

        var control = formContext.getControl("kofc_activityfor");

        if (!control) {
            console.warn(
                "KOFC.Task.filterActivityFor: kofc_activityfor control not found."
            );
            return;
        }

        /*
         * Task Activity For options
         * Explicit alphabetical order
         */
        var taskOptions = [
            { text: "Annuity",    value: 258510007 },
            { text: "Fraternal",  value: 258510001 },
            { text: "Insurance",  value: 258510000 },
            { text: "Membership", value: 258510008 },
            { text: "Payments",   value: 258510009 },
            { text: "Taxation",   value: 258510010 }
        ];

        // Sort again as an extra safeguard
        taskOptions.sort(function (a, b) {
            return a.text.localeCompare(
                b.text,
                undefined,
                { sensitivity: "base" }
            );
        });

        // Remove every existing choice from the UI control
        control.clearOptions();

        /*
         * IMPORTANT:
         * Do NOT specify an index.
         *
         * Dynamics appends each option to the end,
         * preserving the exact sequence below.
         */
        taskOptions.forEach(function (option) {
            control.addOption({
                text: option.text,
                value: option.value
            });
        });

        // Debug verification
        console.log(
            "KOFC Task Activity For options:",
            control.getOptions().map(function (o) {
                return o.text;
            })
        );

    } catch (error) {
        console.error(
            "KOFC.Task.filterActivityFor error:",
            error
        );
    }
};
